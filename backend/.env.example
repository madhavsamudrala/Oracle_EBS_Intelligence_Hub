# Oracle EBS Intelligence Hub v6.0 — Backend Environment
# Easiest: run configure-secrets.bat (hidden prompts, writes backend\.env).
# Or copy this file to .env and fill in values. backend\.env is git-ignored.

# ICA_AGENT_MODE=true sends the user's question unchanged to the ICA agent,
# which calls the Context Broker tools itself (needs ICA_WORKFLOW_URL + ICA_API_KEY).
ICA_AGENT_MODE=true
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Langflow workflow run URL (Agent Studio flow -> API) and Langflow API key
ICA_WORKFLOW_URL=

# ICA Context Studio API (optional — leave blank for local-only mode)
ICA_API_URL=
ICA_API_KEY=
# Context ID of the NEW Context Studio context (created after uploading ica-schema/)
ICA_CONTEXT_ID=

# MCP Gateway (Context Broker tools, used by backend/app/routes/chat.py)
# MCP_GATEWAY_URL is the gateway server URL ending in /mcp
MCP_GATEWAY_URL=
# MCP_BEARER_TOKEN authenticates to the gateway (Authorization: Bearer ...)
MCP_BEARER_TOKEN=
# MCP_API_KEY is the Context Studio API key, sent as the x-api-key tool argument
MCP_API_KEY=

# BOB endpoint (optional)
BOB_ENDPOINT=

# Debug mode
DEBUG=false
