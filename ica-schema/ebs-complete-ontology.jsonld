        "keyMilestones": [
          "All AP Invoices Validated","All AP Payments Processed",
          "AP Transfer to GL Complete","All AR Invoices Generated",
          "All AR Receipts Applied","AR Transfer to GL Complete",
          "FA Depreciation Run Complete","FA Transfer to GL Complete",
          "Payroll Transfer to GL Complete",
          "Foreign Currency Revaluation Done",
          "Allocation Journals Complete","Intercompany Eliminations Done",
          "Suspense Account Cleared to Zero","Trial Balance Reviewed",
          "FSG Reports Generated","Management Review Complete",
          "GL Period Closed","Financial Statements Published"
        ],
        "periodCloseSequence": [
          "Step 1: Close AP Period",
          "Step 2: Close AR Period",
          "Step 3: Close FA Period",
          "Step 4: Close Payroll Period",
          "Step 5: GL Foreign Currency Revaluation",
          "Step 6: GL Allocation Journals",
          "Step 7: GL Intercompany Eliminations",
          "Step 8: Review Trial Balance",
          "Step 9: Clear Suspense Account",
          "Step 10: Close GL Period"
        ]
      },
      "relatesTo": ["ebs:GL","ebs:AP","ebs:AR","ebs:FA","ebs:CM","ebs:PAY"]
    },

    {
      "id": "ebs:CreateAPInvoice",
      "type": "Operation",
      "name": "Create AP Invoice",
      "description": "Create supplier invoice in AP module with distributions, matching, and accounting.",
      "from": "ebs:AP",
      "to": "ebs:GL",
      "precondition": [
        "Valid supplier and supplier site must exist",
        "ORG_ID must be provided and valid",
        "GL date must be in open AP and GL period",
        "Invoice amount must match distributions",
        "Duplicate invoice check must pass (per vendor)"
      ],
      "postcondition": [
        "Invoice created in ap_invoices_all with distributions",
        "Accounting entries created in XLA (xla_ae_lines)",
        "AME/Workflow triggered for approval routing",
        "Payment schedule created in ap_payment_schedules_all"
      ]
    },

    {
      "id": "ebs:ProcessP2PCycle",
      "type": "Operation",
      "name": "Process Complete P2P Cycle",
      "description": "Execute full procure-to-pay cycle from requisition through bank reconciliation.",
      "from": "ebs:PO",
      "to": "ebs:CM",
      "precondition": [
        "Valid supplier exists in po_vendors",
        "Budget available for requisition amount",
        "AME approver hierarchy configured",
        "Bank account configured for payment",
        "GL accounts and periods configured"
      ],
      "postcondition": [
        "PR created and approved",
        "PO created and approved",
        "Goods received (rcv_transactions)",
        "Invoice matched, validated, and approved",
        "Payment processed (ap_checks_all)",
        "GL entries posted (gl_je_lines)",
        "Bank reconciliation complete"
      ]
    },

    {
      "id": "ebs:ProcessPeriodClose",
      "type": "Operation",
      "name": "Process Month-End Period Close (R2R)",
      "description": "Execute complete month-end period close sequence across all subledgers and GL.",
      "from": "ebs:GL",
      "to": "ebs:GL",
      "precondition": [
        "All subledger (AP/AR/FA/PAY) transfers to GL complete",
        "All journals posted — no journals in 'unposted' status",
        "Suspense account balance = zero",
        "Management approval obtained for closure",
        "All bank reconciliations complete"
      ],
      "postcondition": [
        "GL period status = 'Closed'",
        "Trial balance in balance (Dr = Cr)",
        "Financial statements generated via FSG",
        "Next period opened for transactions",
        "Archive and backup complete"
      ]
    },

    {
      "id": "ebs:Rule_OrgId_Required",
      "type": "Entity",
      "name": "ORG_ID Required on All Multi-Org Tables",
      "description": "All _ALL multi-org tables must include an AND org_id = :p_org_id filter in every SQL query to prevent cross-org data exposure and ensure correct results.",
      "identityKey": "ruleId: COMP-001",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-001",
        "ruleName": "ORG_ID Required",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": -20,
        "affectedModules": ["AP","AR","PO","INV","OM","iEXP","CM","FA"],
        "affectedTables": [
          "ap_invoices_all","ap_invoice_distributions_all","ap_checks_all",
          "ap_holds_all","ap_payment_schedules_all",
          "ra_customer_trx_all","ra_customer_trx_lines_all","ar_cash_receipts_all",
          "po_headers_all","po_lines_all","po_line_locations_all",
          "po_distributions_all","po_requisition_headers_all",
          "mtl_material_transactions","mtl_onhand_quantities_detail",
          "oe_order_headers_all","oe_order_lines_all",
          "ap_expense_report_headers_all"
        ],
        "violationImpact": "Full cross-org table scan, wrong org data returned, performance degradation, data security breach, multi-org compliance failure",
        "correctUsage": "WHERE table.org_id = :p_org_id",
        "incorrectUsage": "Missing org_id filter entirely from WHERE clause"
      },
      "invariant": [
        "org_id must be present in WHERE clause",
        "org_id must use bind variable :p_org_id not hardcoded value",
        "org_id must reference the correct operating unit"
      ]
    },

    {
      "id": "ebs:Rule_DateTrack_Required",
      "type": "Entity",
      "name": "DateTrack Effective Date Filter Required",
      "description": "All HRMS/PAY/BEN DateTracked tables (with _F suffix) require BETWEEN effective_start_date AND effective_end_date filter.",
      "identityKey": "ruleId: COMP-002",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-002",
        "ruleName": "DateTrack Filter Required",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": -20,
        "affectedModules": ["HRMS","PAY","BEN"],
        "affectedTables": [
          "per_all_people_f","per_all_assignments_f","hr_all_positions_f",
          "pay_payrolls_f","pay_element_types_f","pay_input_values_f",
          "pay_element_entries_f","pay_element_entry_values_f",
          "ben_prtt_enrt_rslt_f","ben_pgm_f","ben_pl_f","ben_pl_typ_f","ben_opt_f","ben_ler_f"
        ],
        "violationImpact": "Multiple rows returned per employee/element (one per change history), incorrect aggregations, wrong headcount, payroll calculation errors",
        "correctUsage": "WHERE SYSDATE BETWEEN table.effective_start_date AND table.effective_end_date",
        "historicalUsage": "WHERE :p_as_of_date BETWEEN table.effective_start_date AND table.effective_end_date",
        "incorrectUsage": "Missing date filter on any DateTracked _F table"
      }
    },

    {
      "id": "ebs:Rule_GL_LedgerId",
      "type": "Entity",
      "name": "GL Tables Use ledger_id Not org_id",
      "description": "GL module tables use ledger_id for scoping, NOT org_id. Using org_id on GL tables returns incorrect results or errors.",
      "identityKey": "ruleId: COMP-003",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-003",
        "ruleName": "GL Ledger ID Filter",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": -20,
        "affectedModules": ["GL"],
        "affectedTables": [
          "gl_je_headers","gl_je_lines","gl_balances",
          "gl_ledgers","gl_period_statuses","gl_budget_versions",
          "xla_ae_headers","xla_ae_lines"
        ],
        "violationImpact": "Wrong ledger data returned, cross-ledger data mixing, incorrect financial statements, reporting failures",
        "correctUsage": "WHERE gjh.ledger_id = :p_ledger_id",
        "incorrectUsage": "WHERE gjh.org_id = :p_org_id  -- WRONG: GL uses ledger_id"
      }
    },

    {
      "id": "ebs:Rule_Cancelled_Invoice_Filter",
      "type": "Entity",
      "name": "Exclude Cancelled AP Invoices",
      "description": "Always exclude cancelled invoices from AP reporting by adding AND cancelled_date IS NULL.",
      "identityKey": "ruleId: COMP-004",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-004",
        "ruleName": "Cancelled Invoice Filter",
        "category": "COMPLIANCE",
        "severity": "MAJOR",
        "codeReviewScore": -10,
        "affectedModules": ["AP"],
        "affectedTables": ["ap_invoices_all"],
        "violationImpact": "Cancelled invoices appear in aging, payment runs, and outstanding balance reports — incorrect financial totals",
        "correctUsage": "AND aia.cancelled_date IS NULL",
        "incorrectUsage": "Missing cancelled_date IS NULL filter"
      }
    },

    {
      "id": "ebs:Rule_Reversal_Distribution_Filter",
      "type": "Entity",
      "name": "Exclude Reversal Distributions",
      "description": "Always exclude reversal distributions from AP distribution queries: AND reversal_flag != 'Y'.",
      "identityKey": "ruleId: COMP-005",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-005",
        "ruleName": "Reversal Distribution Filter",
        "category": "COMPLIANCE",
        "severity": "MAJOR",
        "codeReviewScore": -10,
        "affectedModules": ["AP"],
        "affectedTables": ["ap_invoice_distributions_all"],
        "violationImpact": "Double counting of distribution amounts, incorrect GL reconciliation, wrong cost allocation totals",
        "correctUsage": "AND aida.reversal_flag != 'Y'",
        "incorrectUsage": "Missing reversal_flag filter"
      }
    },

    {
      "id": "ebs:Rule_Primary_Assignment_Filter",
      "type": "Entity",
      "name": "Primary Assignment Filter Required",
      "description": "Always filter primary_flag = 'Y' on per_all_assignments_f to return only the primary assignment per employee.",
      "identityKey": "ruleId: COMP-006",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-006",
        "ruleName": "Primary Assignment Filter",
        "category": "COMPLIANCE",
        "severity": "MAJOR",
        "codeReviewScore": -10,
        "affectedModules": ["HRMS","PAY"],
        "affectedTables": ["per_all_assignments_f"],
        "violationImpact": "Multiple assignment rows per employee, inflated headcount, duplicate payroll processing risk",
        "correctUsage": "AND paaf.primary_flag = 'Y'",
        "incorrectUsage": "Missing primary_flag = 'Y' filter"
      }
    },

    {
      "id": "ebs:Rule_Bind_Variables",
      "type": "Entity",
      "name": "Bind Variables Required — No Hard-Coded Literals",
      "description": "Always use bind variables (:p_name) in SQL queries. Hard-coded literals cause SQL injection risk, hard-parsing, and shared pool exhaustion.",
      "identityKey": "ruleId: COMP-007",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-007",
        "ruleName": "Bind Variables Required",
        "category": "SECURITY",
        "severity": "CRITICAL",
        "codeReviewScore": -20,
        "affectedModules": ["AP","AR","GL","PO","INV","HRMS","PAY","FA","CM","BEN","iEXP","OM"],
        "violationImpact": "SQL injection vulnerability, hard-parsing on every execution, shared pool exhaustion, security audit failure",
        "correctUsage": "WHERE org_id = :p_org_id AND vendor_id = :p_vendor_id",
        "incorrectUsage": "WHERE org_id = 101 AND vendor_id = 5432  -- NEVER hardcode IDs"
      }
    },

    {
      "id": "ebs:Rule_No_Select_Star",
      "type": "Entity",
      "name": "No SELECT * in Production SQL",
      "description": "Never use SELECT * in production Oracle EBS queries. Always name columns explicitly.",
      "identityKey": "ruleId: COMP-008",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-008",
        "ruleName": "No SELECT Star",
        "category": "PERFORMANCE",
        "severity": "MAJOR",
        "codeReviewScore": -10,
        "affectedModules": ["AP","AR","GL","PO","INV","HRMS","PAY"],
        "violationImpact": "Full row fetch overhead, excess network bandwidth, index-only scan impossible, implicit conversion risks, columns shift on DDL changes",
        "correctUsage": "SELECT invoice_num, invoice_amount, vendor_name FROM ap_invoices_all aia",
        "incorrectUsage": "SELECT * FROM ap_invoices_all  -- NEVER use SELECT *"
      }
    },

    {
      "id": "ebs:Rule_No_Function_On_Index",
      "type": "Entity",
      "name": "No Functions on Indexed Columns",
      "description": "Avoid wrapping indexed columns in functions (TRUNC, TO_CHAR, NVL) as this prevents index usage and forces full table scans.",
      "identityKey": "ruleId: COMP-009",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-009",
        "ruleName": "No Function on Indexed Column",
        "category": "PERFORMANCE",
        "severity": "MAJOR",
        "codeReviewScore": -10,
        "affectedModules": ["AP","AR","GL","PO","INV","HRMS","PAY"],
        "violationImpact": "Index scan disabled, full table scan required, query performance 10x-100x degraded on large _ALL tables",
        "correctUsage": "WHERE invoice_date BETWEEN :p_start_date AND :p_end_date",
        "incorrectUsage": "WHERE TO_CHAR(invoice_date, 'YYYY') = '2025'  -- prevents index use"
      }
    },

    {
      "id": "ebs:Rule_HRMS_Business_Group",
      "type": "Entity",
      "name": "HRMS Tables Use business_group_id Not org_id",
      "description": "Oracle HRMS people and assignment tables use business_group_id for filtering, NOT org_id.",
      "identityKey": "ruleId: COMP-010",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-010",
        "ruleName": "HRMS Business Group Filter",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": -20,
        "affectedModules": ["HRMS"],
        "affectedTables": [
          "per_all_people_f","per_all_assignments_f",
          "per_periods_of_service","per_jobs","per_grades",
          "per_business_groups","hr_all_organization_units"
        ],
        "violationImpact": "Cross business-group employee data, wrong employee records returned, security policy violation, HRMS data exposure",
        "correctUsage": "WHERE papf.business_group_id = :p_business_group_id",
        "incorrectUsage": "WHERE papf.org_id = :p_org_id  -- WRONG: HRMS uses business_group_id"
      }
    },

    {
      "id": "ebs:SQLPattern_AP_Invoice_Basic",
      "type": "Entity",
      "name": "AP Basic Invoice Query Pattern",
      "description": "Standard Oracle EBS pattern for AP invoice queries — includes all required mandatory filters: org_id, cancelled_date, and date range.",
      "identityKey": "patternId: SQL-AP-001",
      "humanRef": "patternName",
      "attributes": {
        "patternId": "SQL-AP-001",
        "patternName": "AP Invoice Basic Query",
        "module": "AP",
        "patternType": "SELECT",
        "difficulty": "BEGINNER",
        "requiredFilters": ["org_id filter mandatory","cancelled_date IS NULL","Date range filter recommended"],
        "templateSQL": "SELECT aia.invoice_num, aia.invoice_date, aia.invoice_amount, aia.approval_status, aia.payment_status_flag, pv.vendor_name FROM ap_invoices_all aia, po_vendors pv WHERE aia.vendor_id = pv.vendor_id AND aia.org_id = :p_org_id AND aia.cancelled_date IS NULL AND aia.invoice_date BETWEEN :p_start_date AND :p_end_date ORDER BY aia.invoice_date DESC"
      }
    },

    {
      "id": "ebs:SQLPattern_GL_Journal_Basic",
      "type": "Entity",
      "name": "GL Basic Journal Query Pattern",
      "description": "Standard Oracle EBS pattern for GL journal queries — uses ledger_id (NOT org_id), filters posted journals, restricts by period.",
      "identityKey": "patternId: SQL-GL-001",
      "humanRef": "patternName",
      "attributes": {
        "patternId": "SQL-GL-001",
        "patternName": "GL Journal Basic Query",
        "module": "GL",
        "patternType": "SELECT",
        "difficulty": "BEGINNER",
        "requiredFilters": ["ledger_id filter mandatory","status = 'P' for posted journals","period_name filter recommended","summary_flag = 'N' on gl_code_combinations"],
        "templateSQL": "SELECT gjh.name AS journal_name, gjh.je_source, gjh.je_category, gjh.period_name, gjh.status, gjh.running_total_dr, gjh.running_total_cr, gjl.je_line_num, gjl.entered_dr, gjl.entered_cr, gcc.concatenated_segments AS account FROM gl_je_headers gjh, gl_je_lines gjl, gl_code_combinations_kfv gcc WHERE gjh.je_header_id = gjl.je_header_id AND gjl.code_combination_id = gcc.code_combination_id AND gjh.ledger_id = :p_ledger_id AND gjh.period_name = :p_period_name AND gjh.status = 'P' ORDER BY gjh.je_source, gjh.name, gjl.je_line_num"
      }
    },

    {
      "id": "ebs:SQLPattern_HRMS_Employee_Basic",
      "type": "Entity",
      "name": "HRMS Employee Basic Query Pattern",
      "description": "Standard Oracle EBS HRMS pattern — mandatory DateTrack filters on per_all_people_f AND per_all_assignments_f, primary_flag = 'Y', business_group_id filter.",
      "identityKey": "patternId: SQL-HR-001",
      "humanRef": "patternName",
      "attributes": {
        "patternId": "SQL-HR-001",
        "patternName": "HRMS Employee Basic Query",
        "module": "HRMS",
        "patternType": "SELECT",
        "difficulty": "INTERMEDIATE",
        "requiredFilters": ["DateTrack filter on per_all_people_f","DateTrack filter on per_all_assignments_f","primary_flag = 'Y'","business_group_id filter"],
        "templateSQL": "SELECT papf.employee_number, papf.full_name, papf.email_address, paaf.assignment_number, haou.name AS department, pj.name AS job_name, hl.location_code, ppos.date_start AS hire_date FROM per_all_people_f papf, per_all_assignments_f paaf, hr_all_organization_units haou, per_jobs pj, hr_locations_all hl, per_periods_of_service ppos WHERE paaf.person_id = papf.person_id AND paaf.organization_id = haou.organization_id AND paaf.job_id = pj.job_id(+) AND paaf.location_id = hl.location_id(+) AND ppos.person_id = papf.person_id AND SYSDATE BETWEEN papf.effective_start_date AND papf.effective_end_date AND SYSDATE BETWEEN paaf.effective_start_date AND paaf.effective_end_date AND paaf.primary_flag = 'Y' AND papf.business_group_id = :p_business_group_id ORDER BY haou.name, papf.last_name"
      }
    },

    {
      "id": "ebs:SQLPattern_P2P_Status",
      "type": "Entity",
      "name": "P2P End-to-End Status Query Pattern",
      "description": "Complete P2P status query — traces a requisition from PR through PO → Receipt → AP Invoice → Payment in a single SQL using outer joins.",
      "identityKey": "patternId: SQL-P2P-001",
      "humanRef": "patternName",
      "attributes": {
        "patternId": "SQL-P2P-001",
        "patternName": "P2P Complete Status Query",
        "module": "PO",
        "patternType": "SELECT",
        "difficulty": "ADVANCED",
        "requiredFilters": ["org_id filter on po_headers_all","Outer joins for optional downstream stages"],
        "templateSQL": "SELECT prh.segment1 AS req_number, pha.segment1 AS po_number, pv.vendor_name, rsh.receipt_num, aia.invoice_num, aia.invoice_amount, aca.check_number, aca.check_date, aca.amount AS payment_amount, gcc.concatenated_segments AS charge_account FROM po_requisition_headers_all prh, po_requisition_lines_all prl, po_req_distributions_all prd, po_headers_all pha, po_lines_all pla, po_line_locations_all plla, po_distributions_all pda, po_vendors pv, rcv_shipment_headers rsh, rcv_shipment_lines rsl, rcv_transactions rt, ap_invoices_all aia, ap_invoice_distributions_all aida, ap_invoice_payments_all aipa, ap_checks_all aca, gl_code_combinations_kfv gcc WHERE prl.requisition_header_id = prh.requisition_header_id AND prd.requisition_line_id = prl.requisition_line_id AND pda.req_distribution_id = prd.distribution_id AND pda.po_header_id = pha.po_header_id AND pda.po_line_id = pla.po_line_id AND pda.line_location_id = plla.line_location_id AND pha.vendor_id = pv.vendor_id AND rsl.po_header_id(+) = pha.po_header_id AND rsh.shipment_header_id(+) = rsl.shipment_header_id AND rt.shipment_line_id(+) = rsl.shipment_line_id AND rt.transaction_type(+) = 'RECEIVE' AND aida.po_distribution_id(+) = pda.po_distribution_id AND aia.invoice_id(+) = aida.invoice_id AND aipa.invoice_id(+) = aia.invoice_id AND aca.check_id(+) = aipa.check_id AND gcc.code_combination_id = pda.code_combination_id AND pha.org_id = :p_org_id ORDER BY prh.segment1, pha.segment1"
      }
    },

    {
      "id": "ebs:SQLPattern_O2C_Status",
      "type": "Entity",
      "name": "O2C End-to-End Status Query Pattern",
      "description": "Complete O2C status query — traces a sales order from Order → Delivery → AR Invoice → Cash Receipt in a single SQL using outer joins.",
      "identityKey": "patternId: SQL-O2C-001",
      "humanRef": "patternName",
      "attributes": {
        "patternId": "SQL-O2C-001",
        "patternName": "O2C Complete Status Query",
        "module": "OM",
        "patternType": "SELECT",
        "difficulty": "ADVANCED",
        "requiredFilters": ["org_id filter mandatory","Outer joins for optional downstream stages","AutoInvoice interface context filter"]
      }
    },

    {
      "id": "ebs:SQLPattern_Payroll_Results",
      "type": "Entity",
      "name": "Payroll Run Results Query Pattern",
      "description": "Standard Oracle Payroll pattern — queries payroll run results with mandatory DateTrack filters on element and assignment tables.",
      "identityKey": "patternId: SQL-PAY-001",
      "humanRef": "patternName",
      "attributes": {
        "patternId": "SQL-PAY-001",
        "patternName": "Payroll Results Query",
        "module": "PAY",
        "patternType": "SELECT",
        "difficulty": "ADVANCED",
        "requiredFilters": ["DateTrack filters on all PAY _f tables","action_type = 'R' for payroll runs","action_status = 'C' for completed runs"]
      }
    },

    {
      "id": "ebs:EBSReport_InvoiceRegister",
      "type": "RICEComponent",
      "name": "Invoice Register (APXINREG)",
      "description": "RDF-based AP Invoice Register report — lists all invoices for a period with vendor, amount, currency, approval status and payment status.",
      "identityKey": "reportId: RPT-AP-001",
      "humanRef": "reportName",
      "attributes": {
        "reportId": "RPT-AP-001",
        "reportName": "Invoice Register",
        "riceCategory": "R",
        "reportType": "RDF",
        "module": "AP",
        "businessProcess": "P2P",
        "concurrentProgramName": "APXINREG",
        "executableMethod": "ORACLE_REPORTS",
        "outputFormat": "PDF",
        "orgIdRequired": true,
        "multiOrgEnabled": true,
        "keyTables": ["ap_invoices_all","po_vendors","po_vendor_sites_all"],
        "parameters": ["p_org_id","p_start_date","p_end_date"],
        "primarySQLQuery": "SELECT aia.invoice_num, aia.invoice_date, aia.invoice_amount, aia.amount_paid, aia.invoice_currency_code, pv.vendor_name, pvs.vendor_site_code, aia.description, aia.payment_status_flag, aia.approval_status FROM ap_invoices_all aia, po_vendors pv, po_vendor_sites_all pvs WHERE aia.vendor_id = pv.vendor_id AND aia.vendor_site_id = pvs.vendor_site_id AND aia.org_id = :p_org_id AND aia.invoice_date BETWEEN :p_start_date AND :p_end_date ORDER BY pv.vendor_name, aia.invoice_num"
      },
      "relatesTo": ["ebs:AP","ebs:P2P_Process"]
    },

