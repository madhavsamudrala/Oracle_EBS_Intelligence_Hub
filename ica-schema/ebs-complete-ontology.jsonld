      "name": "Record-to-Report",
      "description": "Month-end financial close: Subledger Transactions → GL Transfer → Journals → Period Close Sequence → Trial Balance → Financial Statements.",
      "identityKey": "processCode: R2R",
      "humanRef": "processName",
      "attributes": {
        "processCode": "R2R",
        "fullName": "Record-to-Report",
