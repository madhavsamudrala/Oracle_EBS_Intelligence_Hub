{
  "@context": {
    "ebs":              "http://ibm.com/oracle-ebs#",
    "schema":           "http://schema.org/",
    "owl":              "http://www.w3.org/2002/07/owl#",
    "rdfs":             "http://www.w3.org/2000/01/rdf-schema#",
    "xsd":              "http://www.w3.org/2001/XMLSchema#",
    "dcterms":          "http://purl.org/dc/terms/",
    "skos":             "http://www.w3.org/2004/02/skos/core#",
    "id":               "@id",
    "type":             "@type",
    "name":             "schema:name",
    "description":      "schema:description",
    "attributes":       "ebs:attributes",
    "identityKey":      "ebs:identityKey",
    "humanRef":         "ebs:humanRef",
    "invariant":        "ebs:invariant",
    "relatesTo":        { "@id": "ebs:relatesTo",        "@type": "@id" },
    "from":             { "@id": "ebs:from",             "@type": "@id" },
    "to":               { "@id": "ebs:to",               "@type": "@id" },
    "precondition":     "ebs:precondition",
    "postcondition":    "ebs:postcondition",
    "sqlExample":       "ebs:sqlExample",
    "businessRule":     "ebs:businessRule",
    "keyTables":        "ebs:keyTables",
    "complianceRule":   "ebs:complianceRule",
    "troubleshootingGuide": "ebs:troubleshootingGuide",
    "interviewQuestions":   "ebs:interviewQuestions",
    "learningObjectives":   "ebs:learningObjectives",
    "Entity":           "ebs:Entity",
    "Operation":        "ebs:Operation",
    "BusinessProcess":  "ebs:BusinessProcess",
    "RICEComponent":    "ebs:RICEComponent",
    "ModuleKnowledge":  "ebs:ModuleKnowledge"
  },

  "@graph": [

    {
      "id": "ebs:",
      "type": "owl:Ontology",
      "dcterms:title": "Oracle EBS Enterprise Intelligence and Learning Platform — Complete Ontology",
      "dcterms:description": "Complete JSON-LD ontology for Oracle EBS R12 Intelligence Hub. Covers all EBS modules (AP, AR, GL, PO, HRMS, PAY, INV, OM, FA, CM, BEN, iEXP), business processes (P2P, O2C, H2R, R2R), RICE components (Reports, Interfaces, Conversions, Extensions), AME, Workflows, OAF, SOA, APEX, ADF, Redwood, compliance rules (COMP-001 to COMP-010), SQL patterns, and ModuleKnowledge instances with step-by-step guides, SQL examples, and interview questions.",
      "dcterms:version": "5.0-complete",
      "dcterms:creator": "IBM ICA — Oracle EBS Team",
      "dcterms:created": "2025-06-01",
      "owl:versionIRI": "ebs:v5.0-complete",
      "rdfs:seeAlso": "ica-schema/ebs-ontology.jsonld",
      "rdfs:comment": "ICA Context Studio primary upload target — import this file to generate the full Oracle EBS Enterprise knowledge graph. Companion to ebs-ontology.jsonld (OWL type definitions)."
    },

    {
      "id": "ebs:AP",
      "type": "Entity",
      "name": "Accounts Payable",
      "description": "Oracle EBS AP module — supplier invoice processing, 3-way matching, payment runs, aging, withholding tax, and GL transfer. Primary process: P2P.",
      "identityKey": "moduleCode: AP",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "AP",
        "moduleName": "Accounts Payable",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "P2P",
        "releaseVersion": "R12.2",
        "licenseType": "CORE",
        "keySchema": "APPS",
        "commonInvoiceTypes": ["STANDARD","CREDIT","DEBIT","PREPAYMENT","EXPENSE REPORT","INTEREST","MIXED"],
        "matchingTypes": ["PO_MATCH_2WAY","PO_MATCH_3WAY","PO_MATCH_4WAY","NO_MATCH"],
        "keySetupSteps": ["Financial Options","Payables Options","Payment Terms","Supplier Master","Banks & Bank Accounts","Payment Documents"]
      },
      "invariant": [
        "All invoices require ORG_ID filter on _ALL tables",
        "Cancelled invoices must be excluded: AND cancelled_date IS NULL",
        "Invoice amounts must balance to distributions",
        "Payment requires approved and validated invoice",
        "3-way match requires approved PO shipment",
        "GL date must be in open AP period",
        "Void payments excluded: AND void_date IS NULL",
        "iExpense rows filtered: AND source = 'NonValidatedWebExpense'"
      ],
      "keyTables": [
        "ap_invoices_all",
        "ap_invoice_distributions_all",
        "ap_invoice_lines_all",
        "ap_holds_all",
        "ap_checks_all",
        "ap_invoice_payments_all",
        "ap_payment_schedules_all",
        "ap_expense_report_headers_all",
        "ap_expense_report_lines_all",
        "po_vendors",
        "po_vendor_sites_all",
        "ap_invoices_interface",
        "ap_invoice_lines_interface"
      ],
      "relatesTo": ["ebs:GL","ebs:PO","ebs:CM","ebs:iEXP","ebs:P2P_Process"]
    },

    {
      "id": "ebs:AR",
      "type": "Entity",
      "name": "Accounts Receivable",
      "description": "Oracle EBS AR module — customer invoicing via AutoInvoice, receipt application, AR aging, lockbox, revenue recognition, and GL transfer. Primary process: O2C.",
      "identityKey": "moduleCode: AR",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "AR",
        "moduleName": "Accounts Receivable",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "O2C",
        "releaseVersion": "R12.2",
        "keySetupSteps": ["AR System Options","Customer Master","Transaction Types","Receipt Classes","AutoAccounting Rules","AutoInvoice Setup","Revenue Rules"]
      },
      "invariant": [
        "All transactions require ORG_ID filter",
        "AutoInvoice requires valid customer bill-to site",
        "Receipts must be applied or on-account (status ACC/UNAPP)",
        "Revenue recognition rules apply for deferred revenue",
        "Period close requires GL transfer complete",
        "Status NOT IN ('CL','VOID') for open items",
        "complete_flag = 'Y' required for completed transactions"
      ],
      "keyTables": [
        "ra_customer_trx_all",
        "ra_customer_trx_lines_all",
        "ar_cash_receipts_all",
        "ar_receivable_applications_all",
        "ar_payment_schedules_all",
        "hz_cust_accounts",
        "hz_parties",
        "hz_cust_site_uses_all",
        "ra_interface_lines_all",
        "ra_interface_errors_all"
      ],
      "relatesTo": ["ebs:GL","ebs:OM","ebs:CM","ebs:O2C_Process"]
    },

    {
      "id": "ebs:GL",
      "type": "Entity",
      "name": "General Ledger",
      "description": "Oracle EBS GL module — chart of accounts, ledger setup, journal entry, period close, subledger accounting (XLA), financial reporting (FSG), budget vs actual.",
      "identityKey": "moduleCode: GL",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "GL",
        "moduleName": "General Ledger",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "R2R",
        "releaseVersion": "R12.2",
        "coaStructure": "segment1:Company, segment2:CostCenter, segment3:Account, segment4:SubAccount, segment5:Product",
        "accountTypes": {"A":"Asset","L":"Liability","O":"OwnerEquity","R":"Revenue","E":"Expense"},
        "actualFlags": {"A":"Actual","B":"Budget","E":"Encumbrance"},
        "periodCloseSequence": ["AP Period","AR Period","FA Period","Payroll Period","GL Revaluation","GL Allocations","Intercompany","Trial Balance","Clear Suspense","Close GL Period"]
      },
      "invariant": [
        "GL uses ledger_id NOT org_id for all filtering",
        "Journals must balance: total_dr = total_cr",
        "Period must be open before posting journals",
        "Suspense account must be zero at period end",
        "COA segment combinations must satisfy cross-validation rules",
        "summary_flag = 'N' required on gl_code_combinations to avoid double-count",
        "actual_flag = 'A' for actuals, 'B' for budget, 'E' for encumbrance"
      ],
      "keyTables": [
        "gl_je_headers","gl_je_lines","gl_balances",
        "gl_code_combinations","gl_code_combinations_kfv",
        "gl_ledgers","gl_period_statuses","gl_budget_versions",
        "xla_events","xla_ae_headers","xla_ae_lines",
        "xla_distribution_links","gl_import_references"
      ],
      "relatesTo": ["ebs:AP","ebs:AR","ebs:FA","ebs:PAY","ebs:CM","ebs:R2R_Process"]
    },

    {
      "id": "ebs:PO",
      "type": "Entity",
      "name": "Purchasing",
      "description": "Oracle EBS PO module — purchase requisitions, purchase orders (Standard/Blanket/Contract/Planned), receiving, 3-way match, supplier management.",
      "identityKey": "moduleCode: PO",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "PO",
        "moduleName": "Purchasing",
        "moduleCategory": "SUPPLY_CHAIN",
        "businessProcess": "P2P",
        "releaseVersion": "R12.2",
        "poTypes": ["STANDARD","BLANKET","CONTRACT","PLANNED"],
        "poStatusFlow": ["INCOMPLETE","IN PROCESS","PRE-APPROVED","APPROVED","CLOSED FOR RECEIVING","CLOSED FOR INVOICING","FINALLY CLOSED"]
      },
      "invariant": [
        "All POs require ORG_ID filter",
        "PO must be in APPROVED status before receipt",
        "Receipt quantity cannot exceed PO shipment quantity",
        "Invoice matching requires APPROVED PO",
        "FINALLY CLOSED PO cannot receive or invoice",
        "Filter authorization_status = 'APPROVED' for valid POs"
      ],
      "keyTables": [
        "po_headers_all","po_lines_all",
        "po_line_locations_all","po_distributions_all",
        "po_requisition_headers_all","po_requisition_lines_all",
        "po_req_distributions_all",
        "po_vendors","po_vendor_sites_all",
        "rcv_shipment_headers","rcv_shipment_lines",
        "rcv_transactions","rcv_receiving_sub_ledger"
      ],
      "relatesTo": ["ebs:AP","ebs:INV","ebs:GL","ebs:P2P_Process"]
    },

    {
      "id": "ebs:HRMS",
      "type": "Entity",
      "name": "Human Resources",
      "description": "Oracle HRMS module — employee master data, assignments, jobs, grades, positions, organisation units. All tables are DateTracked with effective_start_date / effective_end_date.",
      "identityKey": "moduleCode: HRMS",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "HRMS",
        "moduleName": "Human Resources",
        "moduleCategory": "HUMAN_RESOURCES",
        "businessProcess": "H2R",
        "releaseVersion": "R12.2",
        "personTypes": ["EMPLOYEE","APPLICANT","CONTINGENT WORKER","CONTACT","RETIREE"],
        "keyAPIs": ["hr_employee_api.create_employee","hr_assignment_api.update_emp_asg","hr_person_api.create_person","hr_ex_employee_api.actual_termination_emp"]
      },
      "invariant": [
        "HRMS uses business_group_id NOT org_id for people tables",
        "DateTrack filter mandatory: SYSDATE BETWEEN effective_start_date AND effective_end_date",
        "primary_flag = 'Y' required on per_all_assignments_f to get single active assignment",
        "effective_start_date AND effective_end_date filter always required",
        "Person types determine data access and API rules"
      ],
      "keyTables": [
        "per_all_people_f","per_all_assignments_f",
        "per_periods_of_service","per_jobs",
        "hr_all_positions_f","hr_all_organization_units",
        "per_grades","hr_locations_all",
        "per_business_groups","per_person_types"
      ],
      "relatesTo": ["ebs:PAY","ebs:BEN","ebs:GL","ebs:H2R_Process"]
    },

    {
      "id": "ebs:PAY",
      "type": "Entity",
      "name": "Payroll",
      "description": "Oracle Payroll — element structures, fast formulas, payroll processing (Run/Pre-payments/Costing/GL Transfer), EFT generation. All tables are DateTracked.",
      "identityKey": "moduleCode: PAY",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "PAY",
        "moduleName": "Oracle Payroll",
        "moduleCategory": "HUMAN_RESOURCES",
        "businessProcess": "H2R",
        "releaseVersion": "R12.2",
        "payrollCycle": ["Pre-Payroll Activities","Payroll Run","Pre-Payment Verification","Pre-Payments","EFT/Checks","Costing","GL Transfer","Year-End Processing"],
        "elementCategories": ["Earnings","Deductions","Information","Employer Charges"],
        "keyAPIs": ["pay_element_entry_api.create_element_entry","pay_proposal_api.create_salary_proposal","pay_payroll_api","hr_assignment_api"]
      },
      "invariant": [
        "DateTrack filter required for all pay_element_* _f tables",
        "Payroll run must complete before pre-payments",
        "Pre-payments must complete before costing",
        "Costing must complete before GL transfer",
        "Cannot reopen closed payroll period",
        "Fast formulas must compile before payroll run",
        "action_type = 'R' for payroll runs",
        "action_status = 'C' for completed payroll actions"
      ],
      "keyTables": [
        "pay_payrolls_f","pay_element_types_f",
        "pay_element_entries_f","pay_element_entry_values_f",
        "pay_payroll_actions","pay_assignment_actions",
        "pay_run_results","pay_run_values_v",
        "pay_costs","pay_element_classifications"
      ],
      "relatesTo": ["ebs:HRMS","ebs:GL","ebs:BEN","ebs:H2R_Process"]
    },

    {
      "id": "ebs:INV",
      "type": "Entity",
      "name": "Inventory",
      "description": "Oracle Inventory — item master, subinventory management, on-hand quantities, material transactions, serial/lot control, costing. Requires organization_id filter.",
      "identityKey": "moduleCode: INV",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "INV",
        "moduleName": "Oracle Inventory",
        "moduleCategory": "SUPPLY_CHAIN",
        "businessProcess": "P2P",
        "releaseVersion": "R12.2",
        "costingMethods": ["STANDARD","AVERAGE","FIFO","LIFO","ACTUAL"],
        "transactionTypes": ["PO RECEIPT","SALES ORDER ISSUE","MISCELLANEOUS","ACCOUNT ALIAS ISSUE","TRANSFER","CYCLE COUNT"]
      },
      "invariant": [
        "All inventory transactions require organization_id filter",
        "Item must be enabled in the specific organization",
        "Serial controlled items require serial number",
        "Lot controlled items require lot number",
        "Costing method (mtl_parameters) determines valuation logic",
        "Subinventory must be active for transactions"
      ],
      "keyTables": [
        "mtl_system_items_b","mtl_onhand_quantities_detail",
        "mtl_material_transactions","mtl_parameters",
        "mtl_secondary_inventories","cst_item_costs",
        "mtl_lot_numbers","mtl_serial_numbers",
        "cst_item_cost_details"
      ],
      "relatesTo": ["ebs:PO","ebs:OM","ebs:GL","ebs:P2P_Process"]
    },

    {
      "id": "ebs:OM",
      "type": "Entity",
      "name": "Order Management",
      "description": "Oracle Order Management — sales orders, order booking, pick/ship/deliver, ATP check, order holds, AutoInvoice trigger for AR. Primary process: O2C.",
      "identityKey": "moduleCode: OM",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "OM",
        "moduleName": "Order Management",
        "moduleCategory": "SUPPLY_CHAIN",
        "businessProcess": "O2C",
        "releaseVersion": "R12.2",
        "orderStatusFlow": ["ENTERED","BOOKED","PICK RELEASED","SHIPPED","CLOSED","CANCELLED"],
        "holdTypes": ["CREDIT CHECK","MANUAL","ORDER TYPE","SHIPPING","CUSTOMER"]
      },
      "invariant": [
        "Sales order must be BOOKED before pick release",
        "Credit check must pass before booking",
        "Item must be shippable for shipment lines",
        "AutoInvoice creates AR invoice after ship confirm",
        "Order holds prevent all downstream processing",
        "Price list required for all standard orders"
      ],
      "keyTables": [
        "oe_order_headers_all","oe_order_lines_all",
        "oe_order_holds_all","oe_hold_sources_all",
        "oe_hold_definitions","wsh_delivery_details",
        "wsh_new_deliveries","wsh_delivery_assignments"
      ],
      "relatesTo": ["ebs:AR","ebs:INV","ebs:GL","ebs:O2C_Process"]
    },

    {
      "id": "ebs:FA",
      "type": "Entity",
      "name": "Fixed Assets",
      "description": "Oracle Fixed Assets — asset master, depreciation books, mass additions from AP, depreciation run, CIP tracking, retirements, revaluation, GL transfer.",
      "identityKey": "moduleCode: FA",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "FA",
        "moduleName": "Fixed Assets",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "R2R",
        "releaseVersion": "R12.2",
        "depreciationMethods": ["STRAIGHT_LINE (STL)","DOUBLE_DECLINING_BALANCE (DDB)","SUM_OF_YEARS_DIGITS","UNITS_OF_PRODUCTION"],
        "assetTypes": ["CAPITALIZED","CIP","EXPENSED"],
        "keyPrograms": ["FADPRUN (Depreciation)","FAPOST (Create Journals)","FAMASADJ (Mass Additions Post)","FAREPORT (Asset Register)"]
      },
      "invariant": [
        "Asset must be in a book before depreciation runs",
        "Depreciation period must be open",
        "Cannot skip depreciation periods — must run in sequence",
        "CIP (Construction-in-Progress) assets do not depreciate",
        "Retirement requires depreciation catch-up",
        "Mass additions must be posted to create assets",
        "transaction_header_id_out IS NULL for current book records"
      ],
      "keyTables": [
        "fa_assets","fa_books","fa_categories_b",
        "fa_locations","fa_asset_history",
        "fa_mass_additions","fa_deprn_summary",
        "fa_retirements","fa_deprn_detail"
      ],
      "relatesTo": ["ebs:GL","ebs:AP","ebs:R2R_Process"]
    },

    {
      "id": "ebs:CM",
      "type": "Entity",
      "name": "Cash Management",
      "description": "Oracle Cash Management — bank statement import, bank reconciliation, cash forecasting. Links AP payments and AR receipts to bank statement lines.",
      "identityKey": "moduleCode: CM",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "CM",
        "moduleName": "Cash Management",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "R2R",
        "releaseVersion": "R12.2",
        "statementFormats": ["BAI2","SWIFT MT940","SWIFT MT942","MANUAL"],
        "reconciliationMethods": ["AUTOMATIC","MANUAL","BATCH"]
      },
      "invariant": [
        "Bank account must be active for transactions",
        "Statement must be imported before reconciliation",
        "Reconciled items cannot be unreconciled",
        "Bank account linked to GL cash account via account use",
        "AP payments reconcile via check number",
        "AR receipts reconcile via receipt number"
      ],
      "keyTables": [
        "ce_bank_accounts","ce_bank_branches_v",
        "ce_statement_headers","ce_statement_lines",
        "ce_reconciliations","ce_forecast_headers",
        "ce_forecast_lines","ap_bank_accounts_all"
      ],
      "relatesTo": ["ebs:AP","ebs:AR","ebs:GL","ebs:R2R_Process"]
    },

    {
      "id": "ebs:BEN",
      "type": "Entity",
      "name": "Benefits",
      "description": "Oracle Benefits — plan/program administration, open enrollment, life events, dependent tracking, COBRA. All benefit tables are DateTracked.",
      "identityKey": "moduleCode: BEN",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "BEN",
        "moduleName": "Oracle Benefits",
        "moduleCategory": "HUMAN_RESOURCES",
        "businessProcess": "H2R",
        "releaseVersion": "R12.2",
        "lifeEventTypes": ["BIRTH","DEATH","MARRIAGE","DIVORCE","HIRE","TERMINATION","OPEN ENROLLMENT"]
      },
      "invariant": [
        "DateTrack filter required for all ben_* _f tables",
        "Employee must be active for benefits enrollment",
        "Life event required to trigger enrollment change",
        "Open enrollment window must be active",
        "Dependent verification required for family plans",
        "COBRA triggered on qualifying life event"
      ],
      "keyTables": [
        "ben_prtt_enrt_rslt_f","ben_pgm_f","ben_pl_f",
        "ben_pl_typ_f","ben_opt_f","ben_ler_f",
        "ben_enrt_rt","ben_prtt_enrt_dpnt"
      ],
      "relatesTo": ["ebs:HRMS","ebs:PAY","ebs:GL","ebs:H2R_Process"]
    },

    {
      "id": "ebs:iEXP",
      "type": "Entity",
      "name": "iExpense",
      "description": "Oracle iExpense — employee expense report submission, policy enforcement, credit card reconciliation, approval routing, automatic AP invoice creation on approval.",
      "identityKey": "moduleCode: iEXP",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "iEXP",
        "moduleName": "Oracle iExpense",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "P2P",
        "releaseVersion": "R12.2",
        "sourceFilter": "NonValidatedWebExpense",
        "expenseCategories": ["AIRFARE","HOTEL","MEALS","GROUND TRANSPORT","MISCELLANEOUS","CORPORATE CARD"]
      },
      "invariant": [
        "Expense report requires active employee assignment",
        "Receipts required above policy threshold",
        "Policy violations require business justification",
        "Approved expense report creates AP invoice automatically",
        "Advances must be applied before reimbursement",
        "Corporate card transactions must be assigned to expense report",
        "Filter: AND source = 'NonValidatedWebExpense' to isolate iExpense from AP"
      ],
      "keyTables": [
