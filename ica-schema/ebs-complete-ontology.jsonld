        "conditions": [
          {"conditionName": "PO Amount GT 25000", "attributeName": "PO_TOTAL_AMOUNT", "operator": "GREATER_THAN", "conditionValue": "25000"},
          {"conditionName": "PO Amount GT 100000", "attributeName": "PO_TOTAL_AMOUNT", "operator": "GREATER_THAN", "conditionValue": "100000"},
          {"conditionName": "Capital Expenditure", "attributeName": "EXPENDITURE_TYPE", "operator": "EQUALS", "conditionValue": "CAPITAL"}
        ],
        "rules": [
          {"ruleName": "Standard PO Approval", "ruleType": "AUTHORIZATION", "priority": 50, "conditions": ["PO Amount GT 25000"], "actionType": "REQUIRE_APPROVAL", "approverType": "SUPERVISOR"},
          {"ruleName": "Capital PO Approval", "ruleType": "AUTHORIZATION", "priority": 20, "conditions": ["PO Amount GT 100000","Capital Expenditure"], "actionType": "REQUIRE_APPROVAL", "approverType": "POSITION", "approverValue": "VP_PROCUREMENT"}
        ]
      },
      "relatesTo": ["ebs:PO","ebs:P2P_Process"]
    },

