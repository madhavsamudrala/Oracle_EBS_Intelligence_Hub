        "ap_expense_report_lines_all",
        "ap_pol_violations_all",
        "ap_credit_card_trxns_all",
        "ap_invoices_all",
        "ap_checks_all"
      ],
      "relatesTo": ["ebs:AP","ebs:GL","ebs:HRMS","ebs:P2P_Process"]
    },

    {
      "id": "ebs:P2P_Process",
      "type": "BusinessProcess",
      "name": "Procure-to-Pay",
      "description": "End-to-end procurement process: Purchase Requisition → PO → Goods Receipt → AP Invoice Matching → Payment → Bank Reconciliation → GL Posting.",
      "identityKey": "processCode: P2P",
      "humanRef": "processName",
      "attributes": {
        "processCode": "P2P",
        "fullName": "Procure-to-Pay",
        "startEvent": "Purchase Requisition Created",
        "endEvent": "Supplier Payment Cleared in Bank",
        "primaryModules": ["PO","AP","INV"],
        "secondaryModules": ["GL","CM","iEXP"],
        "keyMilestones": [
          "PR Created and Approved",
          "PO Created and Approved",
          "Goods Received (3-way match trigger)",
          "AP Invoice Received and Matched",
          "Invoice Validated and Approved",
          "Payment Processed",
          "Bank Reconciliation Complete",
          "GL Entries Posted"
        ],
        "keyTables": [
          "po_requisition_headers_all","po_headers_all",
          "rcv_transactions","ap_invoices_all","ap_checks_all"
        ],
        "accountingEntries": [
          "PR Approval: DR Requisition Encumbrance / CR Budgetary Control",
          "PO Approval: DR Obligation / CR Requisition Encumbrance",
          "Receipt: DR Receiving Inspection / CR AP Accrual",
          "Delivery: DR Inventory/Expense / CR Receiving Inspection",
          "Invoice Match: DR AP Accrual / CR AP Liability",
          "Payment: DR AP Liability / CR Cash Clearing",
          "Bank Clear: DR Cash Clearing / CR Bank Account"
        ],
        "kpiMetrics": ["Invoice Cycle Time","PO Compliance Rate","Matched Invoice %","Days Payable Outstanding","Payment Discount Captured"]
      },
      "relatesTo": ["ebs:PO","ebs:AP","ebs:INV","ebs:GL","ebs:CM"]
    },

    {
      "id": "ebs:O2C_Process",
      "type": "BusinessProcess",
      "name": "Order-to-Cash",
      "description": "End-to-end order fulfillment: Sales Order → Pick/Ship → AutoInvoice → Cash Receipt → Application → GL Posting → Bank Reconciliation.",
      "identityKey": "processCode: O2C",
      "humanRef": "processName",
      "attributes": {
        "processCode": "O2C",
        "fullName": "Order-to-Cash",
        "startEvent": "Sales Order Created",
        "endEvent": "Cash Receipt Applied and Bank Cleared",
        "primaryModules": ["OM","INV","AR"],
        "secondaryModules": ["GL","CM","PA"],
        "keyMilestones": [
          "Sales Order Created","Order Booked",
          "Credit Check Passed","Pick Released",
          "Items Picked","Ship Confirmed",
          "AutoInvoice Created","Invoice Sent to Customer",
          "Payment Received","Receipt Applied",
          "GL Entries Posted","Bank Reconciled"
        ],
        "keyTables": [
          "oe_order_headers_all","wsh_delivery_details",
          "ra_customer_trx_all","ar_cash_receipts_all",
          "ar_receivable_applications_all"
        ],
        "accountingEntries": [
          "Ship Confirm: DR COGS / CR Inventory Valuation",
          "AutoInvoice: DR Accounts Receivable / CR Revenue",
          "Receipt: DR Bank Account / CR Accounts Receivable",
          "Discount: DR Sales Discount / CR Accounts Receivable"
        ]
      },
      "relatesTo": ["ebs:OM","ebs:INV","ebs:AR","ebs:GL","ebs:CM"]
    },

    {
      "id": "ebs:H2R_Process",
      "type": "BusinessProcess",
      "name": "Hire-to-Retire",
      "description": "End-to-end employee lifecycle: Job Requisition → Hire → Assignment → Benefits → Payroll → Performance → Termination → Final Pay.",
      "identityKey": "processCode: H2R",
      "humanRef": "processName",
      "attributes": {
        "processCode": "H2R",
