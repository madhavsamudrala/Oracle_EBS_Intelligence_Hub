    {
      "id": "ebs:ModuleKnowledge_AP_Setup",
      "type": "ModuleKnowledge",
      "name": "AP Complete Functional Setup Guide",
      "description": "Complete step-by-step guide for Oracle AP functional setup — Financial Options, Payables Options, Payment Terms, Supplier Master, Banks & Payment Documents. Includes common mistakes and best practices.",
      "identityKey": "knowledgeId: AP-FUNC-001",
      "humanRef": "topicName",
      "attributes": {
        "knowledgeId": "AP-FUNC-001",
        "moduleCode": "AP",
        "topicName": "Accounts Payable Complete Functional Setup",
        "topicCategory": "SETUP",
        "difficulty": "INTERMEDIATE",
        "businessProcess": "P2P"
      },
      "learningObjectives": [
        "Configure AP Financial Options and Payables Options",
        "Set up payment terms (NET30, 2/10NET30, IMMEDIATE)",
        "Create Supplier Master with sites and bank accounts",
        "Configure payment methods (CHECK, EFT, WIRE, CLEARING)",
        "Understand Multi-Org setup for AP",
        "Configure AP approval workflows via AME",
        "Set up AP accounting options and GL accounts"
      ],
      "troubleshootingGuide": "Common AP Setup Issues: (1) Supplier site not assigned to correct ORG_ID — navigate to Supplier Sites and assign operating unit. (2) Missing liability account in Financial Options — check Payables > Setup > Options > Financial. (3) Payment terms mismatch between PO and invoice — verify terms ID in ap_terms vs po_headers_all. (4) Bank account not linked to payment document — navigate to Setup > Banks > Payment Documents. (5) GL date basis set incorrectly — check Payables Options > Invoice Options > GL Date Basis.",
      "relatesTo": ["ebs:AP","ebs:P2P_Process"]
    },

    {
      "id": "ebs:ModuleKnowledge_AP_InvoiceProcessing",
      "type": "ModuleKnowledge",
      "name": "AP Invoice Processing End-to-End Guide",
      "description": "Complete guide for AP invoice processing — invoice types (Standard/Credit/Debit/Prepayment/Expense/Interest/Mixed), matching types (2-way/3-way/4-way), system holds, approval statuses, and step-by-step entry/validation/posting workflow.",
      "identityKey": "knowledgeId: AP-FUNC-002",
      "humanRef": "topicName",
      "attributes": {
