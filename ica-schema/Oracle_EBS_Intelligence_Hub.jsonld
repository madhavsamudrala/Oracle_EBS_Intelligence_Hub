    {
      "id": "ebs:Report_terminated_employees",
      "name": "Terminated Employees",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: terminated_employees",
      "description": "Terminated Employees - HRMS report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "terminated_employees",
        "reportName": "Terminated Employees",
        "module": "HRMS",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_TERMEMP",
        "columns": "Employee ID; Full Name; Department; Job Title; Hire Date; Termination Date; Termination Reason; Last Salary; Notice Period; Final Pay Date; Rehire Eligible",
        "primarySQLQuery": "SELECT ppf.employee_number,\n       ppf.full_name,\n       haou.name         department,\n       pj.name           job_title,\n       ppf.original_date_of_hire,\n       ppf.actual_termination_date,\n       plr.meaning       termination_reason,\n       pap.proposed_salary_n last_salary,\n       ROUND((ppf.actual_termination_date - ppf.last_day_worked)) notice_days,\n       ppf.final_process_date,\n       ppf.rehire_recommendation\nFROM   per_people_f ppf\nJOIN   per_assignments_f paf ON paf.person_id = ppf.person_id AND paf.primary_flag='Y'\nJOIN   per_jobs         pj   ON pj.job_id = paf.job_id\nJOIN   hr_all_organization_units haou ON haou.organization_id = paf.organization_id\nJOIN   per_pay_proposals pap ON pap.assignment_id = paf.assignment_id\nJOIN   per_lookup_values plr ON plr.lookup_code = ppf.leaving_reason AND plr.lookup_type='LEAV_REAS'\nWHERE  ppf.current_employee_flag = 'N'\nAND    ppf.actual_termination_date >= ADD_MONTHS(SYSDATE,-12)\nORDER BY ppf.actual_termination_date DESC",
        "appDataKey": "terminated_employees",
        "relationships": "report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_uses_table -> PER_ALL_ASSIGNMENTS_F; report_uses_table -> PER_JOBS; report_uses_table -> PER_LOOKUP_VALUES; report_uses_table -> PER_PAY_PROPOSALS; report_uses_table -> PER_ALL_PEOPLE_F; report_belongs_to_module -> Human Resources"
      },
      "relatesTo": [
        "ebs:Table_HR_ALL_ORGANIZATION_UNITS",
        "ebs:Table_PER_ALL_ASSIGNMENTS_F",
        "ebs:Table_PER_JOBS",
        "ebs:Table_PER_LOOKUP_VALUES",
        "ebs:Table_PER_PAY_PROPOSALS",
        "ebs:Table_PER_ALL_PEOPLE_F",
        "ebs:HRMS"
      ]
    },
    {
      "id": "ebs:Report_supervisor_details",
      "name": "Supervisor Details",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: supervisor_details",
      "description": "Supervisor Details - HRMS report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "supervisor_details",
        "reportName": "Supervisor Details",
        "module": "HRMS",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_SUP",
        "columns": "Supervisor ID; Supervisor Name; Job Title; Department; Direct Reports; Total Headcount; Approval Limit; Location; Email; Manager Level",
        "primarySQLQuery": "SELECT ppf_sup.employee_number,\n       ppf_sup.full_name       supervisor_name,\n       pj.name                 job_title,\n       haou.name               department,\n       COUNT(paf_sub.person_id) direct_reports,\n       COUNT(paf_sub.person_id) total_headcount,\n       ppf_sup.email_address,\n       hl.location_code,\n       plr.meaning             mgr_level\nFROM   per_people_f     ppf_sup\nJOIN   per_assignments_f paf_sup ON paf_sup.person_id = ppf_sup.person_id AND paf_sup.primary_flag='Y'\n  AND SYSDATE BETWEEN paf_sup.effective_start_date AND paf_sup.effective_end_date\nJOIN   per_assignments_f paf_sub ON paf_sub.supervisor_id = ppf_sup.person_id\nJOIN   per_jobs          pj   ON pj.job_id = paf_sup.job_id\nJOIN   hr_all_organization_units haou ON haou.organization_id = paf_sup.organization_id\nJOIN   hr_locations_all  hl   ON hl.location_id = paf_sup.location_id\nLEFT   JOIN per_lookup_values plr ON plr.lookup_code = paf_sup.manager_level\nGROUP BY ppf_sup.employee_number, ppf_sup.full_name, pj.name, haou.name,\n         ppf_sup.email_address, hl.location_code, plr.meaning\nORDER BY direct_reports DESC",
        "appDataKey": "supervisor_details",
        "relationships": "report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_uses_table -> HR_LOCATIONS_ALL; report_uses_table -> PER_ALL_ASSIGNMENTS_F; report_uses_table -> PER_JOBS; report_uses_table -> PER_LOOKUP_VALUES; report_uses_table -> PER_ALL_PEOPLE_F; report_belongs_to_module -> Human Resources"
      },
      "relatesTo": [
        "ebs:Table_HR_ALL_ORGANIZATION_UNITS",
        "ebs:Table_HR_LOCATIONS_ALL",
        "ebs:Table_PER_ALL_ASSIGNMENTS_F",
        "ebs:Table_PER_JOBS",
        "ebs:Table_PER_LOOKUP_VALUES",
        "ebs:Table_PER_ALL_PEOPLE_F",
        "ebs:HRMS"
      ]
    },
    {
      "id": "ebs:Report_expense_cost_allocation",
      "name": "Expense Cost Allocation",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: expense_cost_allocation",
      "description": "Expense Cost Allocation - HRMS report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "expense_cost_allocation",
        "reportName": "Expense Cost Allocation",
        "module": "HRMS",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_COST",
        "columns": "Employee ID; Employee Name; Department; Cost Center; GL Account; Expense Type; Expense Amount; Fund; Program; Project; Task; Report Period",
        "primarySQLQuery": "SELECT ppf.employee_number,\n       ppf.full_name,\n       haou.name              department,\n       gcc.segment2           cost_center,\n       gcc.concatenated_segments gl_account,\n       oiel.web_parameter_id  expense_type,\n       oiel.amount            expense_amount,\n       gcc.segment4           fund,\n       gcc.segment3           program,\n       oiel.project_id,\n       oiel.task_id,\n       TO_CHAR(oiea.week_end_date,'YYYY-MM') report_period\nFROM   ap_expense_report_headers_all oiea\nJOIN   ap_expense_report_lines_all   oiel ON oiel.report_header_id = oiea.report_header_id\nJOIN   per_people_f  ppf ON ppf.person_id = oiea.employee_id\nJOIN   hr_all_organization_units haou ON haou.organization_id = oiea.org_id\nJOIN   gl_code_combinations gcc ON gcc.code_combination_id = oiel.code_combination_id\nWHERE  oiea.source = 'Both'\nAND    oiea.workflow_approved_flag = 'A'\nORDER BY ppf.full_name, oiea.week_end_date",
        "appDataKey": "expense_cost_allocation",
        "relationships": "report_uses_table -> AP_EXPENSE_REPORT_HEADERS_ALL; report_uses_table -> AP_EXPENSE_REPORT_LINES_ALL; report_uses_table -> GL_CODE_COMBINATIONS; report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_uses_table -> PER_ALL_PEOPLE_F; report_belongs_to_module -> Human Resources"
