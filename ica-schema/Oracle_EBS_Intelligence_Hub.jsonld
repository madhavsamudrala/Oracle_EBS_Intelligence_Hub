    {
      "id": "ebs:AppRule_RULE_024",
      "name": "Use BULK COLLECT for Large Data Sets",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_024",
      "description": "Cursor FOR LOOP with individual row processing on large Oracle EBS tables (>1000 rows) causes context switch overhead. Use BULK COLLECT with FORALL for 10x-100x performance improvement",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_024",
        "rule_name": "Use BULK COLLECT for Large Data Sets",
        "rule_type": "sql_compliance",
        "category": "Performance",
        "severity": "Major",
        "applies_to_tables": "all",
        "sql_pattern": "FOR rec IN (SELECT ... FROM large_table) LOOP single row DML FORALL not used",
        "correction": "FETCH cur BULK COLLECT INTO l_table LIMIT 1000; FORALL i IN l_table.FIRST..l_table.LAST",
        "code_review_check_number": "14",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_025",
      "name": "Explicit Transaction Control in PL/SQL",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_025",
      "description": "PL/SQL procedures making DML changes must have explicit COMMIT/ROLLBACK with proper exception handler. Missing exception handling leaves transactions in uncommitted state",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_025",
        "rule_name": "Explicit Transaction Control in PL/SQL",
        "rule_type": "sql_compliance",
        "category": "Data Integrity",
        "severity": "Major",
        "applies_to_tables": "all",
        "sql_pattern": "INSERT/UPDATE/DELETE in PL/SQL without EXCEPTION handler and ROLLBACK",
        "correction": "EXCEPTION WHEN OTHERS THEN ROLLBACK; RAISE_APPLICATION_ERROR(-20001, SQLERRM);",
        "code_review_check_number": "17",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_026",
      "name": "WHO Columns Required in Custom Tables",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_026",
      "description": "All custom Oracle EBS tables (XXCUST_*) must include WHO columns: CREATED_BY, CREATION_DATE, LAST_UPDATED_BY, LAST_UPDATE_DATE, LAST_UPDATE_LOGIN. Required for Oracle support and audit compliance",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_026",
