    {
      "id": "ebs:Report_suppliers_report",
      "name": "Suppliers Report",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: suppliers_report",
      "description": "Suppliers Report - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "suppliers_report",
        "reportName": "Suppliers Report",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_SUPPLIERS",
        "columns": "Supplier ID; Supplier Name; Type; Status; TIN/Tax ID; Country; State; City; Phone; Hold Status; Sites; Created Date",
        "primarySQLQuery": "SELECT aps.vendor_id,\n       aps.vendor_name,\n       aps.vendor_type_lookup_code  vendor_type,\n       aps.enabled_flag             status,\n       aps.num_1099                 tax_id,\n       aps.country,\n       apss.state,\n       apss.city,\n       aps.phone,\n       aps.hold_flag,\n       COUNT(apss.vendor_site_id)   site_count,\n       aps.creation_date\nFROM   ap_suppliers          aps\nJOIN   ap_supplier_sites_all apss ON apss.vendor_id = aps.vendor_id\nWHERE  aps.enabled_flag = 'Y'\nGROUP BY aps.vendor_id, aps.vendor_name, aps.vendor_type_lookup_code,\n         aps.enabled_flag, aps.num_1099, aps.country, apss.state,\n         apss.city, aps.phone, aps.hold_flag, aps.creation_date\nORDER BY aps.vendor_name",
        "appDataKey": "suppliers_list",
        "relationships": "report_uses_table -> AP_SUPPLIER_SITES_ALL; report_uses_table -> AP_SUPPLIERS; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_SUPPLIER_SITES_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_suppliers_high_payments_by_year",
      "name": "Suppliers High Payments",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: suppliers_high_payments_by_year",
      "description": "Suppliers High Payments - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "suppliers_high_payments_by_year",
        "reportName": "Suppliers High Payments",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_HIGH_PAY",
        "columns": "Supplier Name; Supplier Number; Fiscal Year; Total Payments (USD); Invoice Count; Avg Payment; Last Payment Date; Payment Method; Bank Account; Status",
        "primarySQLQuery": "SELECT aps.vendor_name,\n       aps.segment1                              supplier_number,\n       TO_CHAR(apc.check_date,'YYYY')            fiscal_year,\n       SUM(apip.amount)                          total_payments,\n       COUNT(DISTINCT apia.invoice_id)            invoice_count,\n       ROUND(AVG(apip.amount),2)                 avg_payment,\n       MAX(apc.check_date)                       last_payment_date,\n       apc.payment_method_code                   payment_method,\n       aba.bank_account_num                      bank_account,\n       aps.vendor_type_lookup_code               status\nFROM   ap_suppliers              aps\nJOIN   ap_invoices_all           apia  ON apia.vendor_id   = aps.vendor_id\n                                      AND apia.org_id      = mo_global.get_current_org_id()\nJOIN   ap_invoice_payments       apip  ON apip.invoice_id  = apia.invoice_id\nJOIN   ap_checks_all             apc   ON apc.check_id     = apip.check_id\n                                      AND apc.org_id       = mo_global.get_current_org_id()\n                                      AND apc.void_date    IS NULL\nLEFT JOIN ap_bank_accounts_all   aba   ON aba.bank_account_id = apc.external_bank_account_id\nWHERE  TO_CHAR(apc.check_date,'YYYY') = TO_CHAR(:p_year)\nAND    apip.amount                   > :p_min_amount\nGROUP  BY aps.vendor_name, aps.segment1,\n          TO_CHAR(apc.check_date,'YYYY'),\n          apc.payment_method_code,\n          aba.bank_account_num,\n          aps.vendor_type_lookup_code\nHAVING SUM(apip.amount) > :p_threshold\nORDER  BY total_payments DESC",
        "appDataKey": "suppliers_high_payments_by_year",
        "relationships": "report_uses_table -> AP_BANK_ACCOUNTS_ALL; report_uses_table -> AP_CHECKS_ALL; report_uses_table -> AP_INVOICE_PAYMENTS; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_SUPPLIERS; report_belongs_to_module -> Accounts Payable; report_uses_table -> AP_SUPPLIERS; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_CHECKS_ALL"
      },
      "relatesTo": [
        "ebs:Table_AP_BANK_ACCOUNTS_ALL",
        "ebs:Table_AP_CHECKS_ALL",
        "ebs:Table_AP_INVOICE_PAYMENTS",
        "ebs:Table_AP_INVOICES_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_supplier_paid_invoice_history",
      "name": "Supplier Paid Invoice History",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: supplier_paid_invoice_history",
      "description": "Supplier Paid Invoice History - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "supplier_paid_invoice_history",
        "reportName": "Supplier Paid Invoice History",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_PAID_INV",
        "columns": "Invoice ID; Invoice Num; Vendor Name; Invoice Date; Invoice Type; Invoice Amount; Amount Paid; Payment Date; Check Number; Payment Method; Status",
        "primarySQLQuery": "SELECT apia.invoice_id,\n       apia.invoice_num,\n       aps.vendor_name,\n       apia.invoice_date,\n       apia.invoice_type_lookup_code invoice_type,\n       apia.invoice_amount,\n       apia.amount_paid,\n       apc.check_date payment_date,\n       apc.check_number,\n       apc.payment_method_code,\n       apia.payment_status_flag\nFROM   ap_invoices_all     apia\nJOIN   ap_suppliers        aps  ON aps.vendor_id   = apia.vendor_id\nJOIN   ap_invoice_payments apip ON apip.invoice_id = apia.invoice_id\nJOIN   ap_checks_all       apc  ON apc.check_id    = apip.check_id\nWHERE  apia.payment_status_flag IN ('Y','P')\nAND    apc.check_date BETWEEN :p_start_date AND :p_end_date\nORDER BY apc.check_date DESC",
        "appDataKey": "supplier_paid_invoice_history",
        "relationships": "report_uses_table -> AP_CHECKS_ALL; report_uses_table -> AP_INVOICE_PAYMENTS; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_SUPPLIERS; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_CHECKS_ALL",
        "ebs:Table_AP_INVOICE_PAYMENTS",
        "ebs:Table_AP_INVOICES_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_supplier_payment_history",
      "name": "Supplier Payment History",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: supplier_payment_history",
      "description": "Supplier Payment History - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "supplier_payment_history",
        "reportName": "Supplier Payment History",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_PAY_HIST",
        "columns": "Check ID; Check Number; Vendor Name; Check Date; Check Amount; Bank Account; Currency; Void Flag; Payment Batch; OU Name",
        "primarySQLQuery": "SELECT apc.check_id,\n       apc.check_number,\n       aps.vendor_name,\n       apc.check_date,\n       apc.amount check_amount,\n       apc.bank_account_name,\n       apc.currency_code,\n       apc.void_flag,\n       aba.name payment_batch,\n       haou.name ou_name\nFROM   ap_checks_all        apc\nJOIN   ap_suppliers         aps  ON aps.vendor_id    = apc.vendor_id\nJOIN   ap_batches_all       aba  ON aba.batch_id     = apc.future_pay_due_date\nJOIN   hr_all_organization_units haou ON haou.organization_id = apc.org_id\nWHERE  apc.status_lookup_code = 'CLEARED'\nORDER BY apc.check_date DESC",
        "appDataKey": "supplier_payment_history",
        "relationships": "report_uses_table -> AP_BATCHES_ALL; report_uses_table -> AP_CHECKS_ALL; report_uses_table -> AP_SUPPLIERS; report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_BATCHES_ALL",
        "ebs:Table_AP_CHECKS_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_HR_ALL_ORGANIZATION_UNITS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_supplier_audit",
      "name": "Supplier Audit Report",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: supplier_audit",
      "description": "Supplier Audit Report - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "supplier_audit",
        "reportName": "Supplier Audit Report",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_AUDIT",
        "columns": "Audit ID; Vendor Name; Field Changed; Old Value; New Value; Changed By; Change Date; Change Type; Reason; IP Address",
        "primarySQLQuery": "SELECT faa.audit_id,\n       aps.vendor_name,\n       fac.column_name field_changed,\n       faa.old_value,\n       faa.new_value,\n       fu.user_name changed_by,\n       faa.last_update_date change_date,\n       faa.audit_transaction_type change_type,\n       faa.last_update_login,\n       NULL ip_address\nFROM   fnd_audit_trail faa\nJOIN   fnd_audit_columns fac ON fac.table_app_id = faa.table_app_id\nJOIN   ap_suppliers      aps ON TO_CHAR(aps.vendor_id) = faa.row_key\nJOIN   fnd_user          fu  ON fu.user_id = faa.last_updated_by\nWHERE  fac.table_name = 'AP_SUPPLIERS'\nORDER BY faa.last_update_date DESC",
        "appDataKey": "supplier_audit",
        "relationships": "report_uses_table -> AP_SUPPLIERS; report_uses_table -> FND_AUDIT_COLUMNS; report_uses_table -> FND_AUDIT_TRAIL; report_uses_table -> FND_USER; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_FND_AUDIT_COLUMNS",
        "ebs:Table_FND_AUDIT_TRAIL",
        "ebs:Table_FND_USER",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_aged_payables_detail",
      "name": "Aged Payables Detail",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: aged_payables_detail",
      "description": "Aged Payables Detail - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "aged_payables_detail",
        "reportName": "Aged Payables Detail",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_AGED_AP",
        "columns": "Vendor Name; Invoice Number; Invoice Date; Due Date; Invoice Amount; Current (0-30); 31-60 Days; 61-90 Days; 91-120 Days; Over 120 Days; Total Outstanding",
        "primarySQLQuery": "SELECT aps.vendor_name,\n       apia.invoice_num,\n       apia.invoice_date,\n       apit.due_date,\n       apia.invoice_amount,\n       CASE WHEN SYSDATE-apit.due_date <= 30  THEN apit.amount_remaining ELSE 0 END cur_bucket,\n       CASE WHEN SYSDATE-apit.due_date BETWEEN 31 AND 60 THEN apit.amount_remaining ELSE 0 END b30_60,\n       CASE WHEN SYSDATE-apit.due_date BETWEEN 61 AND 90 THEN apit.amount_remaining ELSE 0 END b61_90,\n       CASE WHEN SYSDATE-apit.due_date BETWEEN 91 AND 120 THEN apit.amount_remaining ELSE 0 END b91_120,\n       CASE WHEN SYSDATE-apit.due_date > 120 THEN apit.amount_remaining ELSE 0 END over120,\n       apit.amount_remaining total_outstanding\nFROM   ap_invoices_all      apia\nJOIN   ap_suppliers         aps  ON aps.vendor_id  = apia.vendor_id\nJOIN   ap_payment_schedules apit ON apit.invoice_id = apia.invoice_id\nWHERE  apit.payment_status_flag != 'Y'\nAND    apia.org_id = :p_org_id\nORDER BY aps.vendor_name, apit.due_date",
        "appDataKey": "aged_payables_detail",
        "relationships": "report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_PAYMENT_SCHEDULES; report_uses_table -> AP_SUPPLIERS; report_belongs_to_module -> Accounts Payable; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_PAYMENT_SCHEDULES_ALL; report_uses_table -> AP_SUPPLIERS"
      },
      "relatesTo": [
        "ebs:Table_AP_INVOICES_ALL",
        "ebs:Table_AP_PAYMENT_SCHEDULES",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:AP",
        "ebs:Table_AP_PAYMENT_SCHEDULES_ALL"
      ]
    },
    {
      "id": "ebs:Report_ap_trial_balance",
      "name": "AP Trial Balance",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: ap_trial_balance",
      "description": "AP Trial Balance - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "ap_trial_balance",
        "reportName": "AP Trial Balance",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_AP_TB",
        "columns": "Vendor Name; GL Account; Liability Balance; Prepayment Balance; Discount Available; Net Balance; Period Name; OU Name",
        "primarySQLQuery": "SELECT aps.vendor_name,\n       gcc.concatenated_segments gl_account,\n       SUM(CASE WHEN aca.accounting_class_code='LIABILITY'\n                THEN aca.accounted_cr - aca.accounted_dr ELSE 0 END) liability_bal,\n       SUM(CASE WHEN aca.accounting_class_code='PREPAID'\n                THEN aca.accounted_cr - aca.accounted_dr ELSE 0 END) prepay_bal,\n       SUM(DECODE(aca.accounting_class_code,'DISCOUNT',aca.accounted_cr,0)) disc_avail,\n       SUM(aca.accounted_cr - aca.accounted_dr) net_bal,\n       gp.period_name,\n       haou.name ou_name\nFROM   ap_ae_lines_all        aca\nJOIN   ap_ae_headers_all      ach  ON ach.ae_header_id = aca.ae_header_id\nJOIN   ap_invoices_all        apia ON apia.invoice_id  = ach.source_id\nJOIN   ap_suppliers           aps  ON aps.vendor_id    = apia.vendor_id\nJOIN   gl_code_combinations   gcc  ON gcc.code_combination_id = aca.code_combination_id\nJOIN   gl_periods             gp   ON gp.period_name   = ach.period_name\nJOIN   hr_all_organization_units haou ON haou.organization_id = apia.org_id\nWHERE  gp.period_name = :p_period\nGROUP BY aps.vendor_name, gcc.concatenated_segments, gp.period_name, haou.name\nORDER BY aps.vendor_name",
        "appDataKey": "ap_trial_balance",
        "relationships": "report_uses_table -> AP_AE_HEADERS_ALL; report_uses_table -> AP_AE_LINES_ALL; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_SUPPLIERS; report_uses_table -> GL_CODE_COMBINATIONS; report_uses_table -> GL_PERIODS; report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_AE_HEADERS_ALL",
        "ebs:Table_AP_AE_LINES_ALL",
        "ebs:Table_AP_INVOICES_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_GL_CODE_COMBINATIONS",
        "ebs:Table_GL_PERIODS",
        "ebs:Table_HR_ALL_ORGANIZATION_UNITS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_invoice_register",
      "name": "Invoice Register",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: invoice_register",
      "description": "Invoice Register - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "invoice_register",
        "reportName": "Invoice Register",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_INV_REG",
        "columns": "Invoice ID; Invoice Num; Vendor Name; Invoice Date; Invoice Type; Invoice Amount; Tax Amount; Freight; Net Amount; Payment Status; GL Period; Batch Name",
        "primarySQLQuery": "SELECT apia.invoice_id,\n       apia.invoice_num,\n       aps.vendor_name,\n       apia.invoice_date,\n       apia.invoice_type_lookup_code,\n       apia.invoice_amount,\n       apia.total_tax_amount,\n       apia.freight_amount,\n       apia.invoice_amount - NVL(apia.total_tax_amount,0) - NVL(apia.freight_amount,0) net_amount,\n       apia.payment_status_flag,\n       apia.gl_date_period_name,\n       aba.name batch_name\nFROM   ap_invoices_all apia\nJOIN   ap_suppliers    aps ON aps.vendor_id = apia.vendor_id\nLEFT   JOIN ap_batches_all aba ON aba.batch_id = apia.batch_id\nWHERE  apia.org_id = :p_org_id\nAND    apia.invoice_date BETWEEN :p_start AND :p_end\nORDER BY apia.invoice_date DESC",
        "appDataKey": "invoice_register",
        "relationships": "report_uses_table -> AP_BATCHES_ALL; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_SUPPLIERS; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_BATCHES_ALL",
        "ebs:Table_AP_INVOICES_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_withholding_tax",
      "name": "Withholding Tax by Supplier",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: withholding_tax",
      "description": "Withholding Tax by Supplier - AP report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "withholding_tax",
        "reportName": "Withholding Tax by Supplier",
        "module": "AP",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_WHT",
        "columns": "Vendor Name; TIN/Tax ID; 1099 Type; Tax Code; Taxable Amount; Withheld Amount; Tax Rate; Payment Date; Invoice Number; GL Account",
        "primarySQLQuery": "SELECT aps.vendor_name,\n       aps.num_1099           tin,\n       aps.vendor_1099        type_1099,\n       awt.tax_name           tax_code,\n       apwt.taxable_base_amount,\n       apwt.withheld_amount,\n       awt.percentage_rate    tax_rate,\n       apc.check_date         payment_date,\n       apia.invoice_num,\n       gcc.concatenated_segments gl_account\nFROM   ap_invoices_all              apia\nJOIN   ap_suppliers                 aps  ON aps.vendor_id = apia.vendor_id\nJOIN   ap_invoice_payments          apip ON apip.invoice_id = apia.invoice_id\nJOIN   ap_checks_all                apc  ON apc.check_id   = apip.check_id\nJOIN   ap_awt_tax_rates_history     apwt ON apwt.invoice_id = apia.invoice_id\nJOIN   ap_tax_codes_all             awt  ON awt.tax_id      = apwt.tax_code_id\nJOIN   gl_code_combinations         gcc  ON gcc.code_combination_id = apwt.awt_related_id\nWHERE  aps.allow_awt_flag = 'Y'\nORDER BY aps.vendor_name, apc.check_date",
        "appDataKey": "withholding_tax",
        "relationships": "report_uses_table -> AP_AWT_TAX_RATES_HISTORY; report_uses_table -> AP_CHECKS_ALL; report_uses_table -> AP_INVOICE_PAYMENTS; report_uses_table -> AP_INVOICES_ALL; report_uses_table -> AP_SUPPLIERS; report_uses_table -> AP_TAX_CODES_ALL; report_uses_table -> GL_CODE_COMBINATIONS; report_belongs_to_module -> Accounts Payable"
      },
      "relatesTo": [
        "ebs:Table_AP_AWT_TAX_RATES_HISTORY",
        "ebs:Table_AP_CHECKS_ALL",
        "ebs:Table_AP_INVOICE_PAYMENTS",
        "ebs:Table_AP_INVOICES_ALL",
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_AP_TAX_CODES_ALL",
        "ebs:Table_GL_CODE_COMBINATIONS",
        "ebs:AP"
      ]
    },
    {
      "id": "ebs:Report_po_detail",
      "name": "PO Detail Report",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: po_detail",
      "description": "PO Detail Report - PO report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "po_detail",
        "reportName": "PO Detail Report",
        "module": "PO",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_PO_DET",
        "columns": "PO Number; PO Type; Vendor Name; Buyer; PO Date; Ship-To; Quantity; Unit Price; Line Total; Approved Status; Need By Date; Description",
        "primarySQLQuery": "SELECT poh.segment1             po_number,\n       poh.type_lookup_code      po_type,\n       aps.vendor_name,\n       ppf.full_name             buyer_name,\n       poh.creation_date         po_date,\n       hl.location_code          ship_to,\n       pol.quantity,\n       pol.unit_price,\n       pol.quantity * pol.unit_price line_total,\n       poh.authorization_status  approved_status,\n       pol.need_by_date,\n       pol.item_description\nFROM   po_headers_all   poh\nJOIN   po_lines_all     pol  ON pol.po_header_id = poh.po_header_id\nJOIN   ap_suppliers     aps  ON aps.vendor_id    = poh.vendor_id\nJOIN   per_people_f     ppf  ON ppf.person_id    = poh.agent_id\nJOIN   hr_locations_all hl   ON hl.location_id   = pol.ship_to_location_id\nWHERE  poh.org_id = :p_org_id\nAND    poh.creation_date BETWEEN :p_start AND :p_end\nORDER BY poh.creation_date DESC",
        "appDataKey": "po_detail",
        "relationships": "report_uses_table -> AP_SUPPLIERS; report_uses_table -> HR_LOCATIONS_ALL; report_uses_table -> PER_ALL_PEOPLE_F; report_uses_table -> PO_HEADERS_ALL; report_uses_table -> PO_LINES_ALL; report_belongs_to_module -> Purchasing"
      },
      "relatesTo": [
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_HR_LOCATIONS_ALL",
        "ebs:Table_PER_ALL_PEOPLE_F",
