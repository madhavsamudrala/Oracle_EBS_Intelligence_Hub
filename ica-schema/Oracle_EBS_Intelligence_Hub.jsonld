    {
      "id": "ebs:ModuleKnowledge_AP_Setup",
      "type": "ModuleKnowledge",
      "name": "AP Complete Functional Setup Guide",
      "description": "Complete step-by-step guide for Oracle AP functional setup — Financial Options, Payables Options, Payment Terms, Supplier Master, Banks & Payment Documents. Includes common mistakes and best practices.",
      "identityKey": "knowledgeId: AP-FUNC-001",
