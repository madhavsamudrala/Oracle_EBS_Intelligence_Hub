    {
      "id": "ebs:AMEConfig_APInvoice",
      "type": "Entity",
      "name": "AP Invoice Approval AME Configuration",
      "description": "AME configuration for AP Invoice approval routing — uses SUPERVISORY approval type with conditions on invoice amount ($10K, $50K, $100K thresholds), vendor type, and invoice type.",
      "identityKey": "ameId: AME-AP-001",
      "humanRef": "ameName",
      "attributes": {
        "ameId": "AME-AP-001",
        "ameName": "AP Invoice Approval",
        "transactionType": "APINVOICE",
        "module": "AP",
        "approvalType": "SUPERVISORY",
        "businessPurpose": "Controls approval routing for AP invoices based on invoice amount, vendor type, and cost center ownership",
        "conditions": "[{\"conditionName\":\"Invoice Amount GT 10000\",\"attributeName\":\"INVOICE_AMOUNT\",\"operator\":\"GREATER_THAN\",\"conditionValue\":\"10000\"},{\"conditionName\":\"Invoice Amount GT 50000\",\"attributeName\":\"INVOICE_AMOUNT\",\"operator\":\"GREATER_THAN\",\"conditionValue\":\"50000\"},{\"conditionName\":\"Invoice Amount GT 100000\",\"attributeName\":\"INVOICE_AMOUNT\",\"operator\":\"GREATER_THAN\",\"conditionValue\":\"100000\"},{\"conditionName\":\"Vendor Type is Employee\",\"attributeName\":\"VENDOR_TYPE\",\"operator\":\"EQUALS\",\"conditionValue\":\"EMPLOYEE\"},{\"conditionName\":\"Invoice Type is Credit Memo\",\"attributeName\":\"INVOICE_TYPE\",\"operator\":\"EQUALS\",\"conditionValue\":\"CREDIT\"}]",
        "rules": "[{\"ruleName\":\"Standard Invoice Approval\",\"ruleType\":\"AUTHORIZATION\",\"priority\":50,\"conditions\":[\"Invoice Amount GT 10000\"],\"actionType\":\"REQUIRE_APPROVAL\",\"approverType\":\"SUPERVISOR\"},{\"ruleName\":\"Senior Manager Approval\",\"ruleType\":\"AUTHORIZATION\",\"priority\":40,\"conditions\":[\"Invoice Amount GT 50000\"],\"actionType\":\"REQUIRE_APPROVAL\",\"approverType\":\"JOB_LEVEL\",\"approverValue\":\"SENIOR_MANAGER\"},{\"ruleName\":\"Executive Approval Required\",\"ruleType\":\"AUTHORIZATION\",\"priority\":30,\"conditions\":[\"Invoice Amount GT 100000\"],\"actionType\":\"REQUIRE_APPROVAL\",\"approverType\":\"POSITION\",\"approverValue\":\"CFO_POSITION\"},{\"ruleName\":\"Employee Expense Exception\",\"ruleType\":\"EXCEPTION\",\"priority\":10,\"conditions\":[\"Vendor Type is Employee\"],\"actionType\":\"SKIP_APPROVER\",\"approverType\":\"SUPERVISOR\"}]"
      },
      "relatesTo": [
        "ebs:AP",
        "ebs:P2P_Process"
      ]
    },
    {
      "id": "ebs:AMEConfig_PO",
      "type": "Entity",
      "name": "PO Approval AME Configuration",
      "description": "AME configuration for Purchase Order approval routing — uses POSITION-based approval with conditions on PO total amount and expenditure type (capital vs operational).",
      "identityKey": "ameId: AME-PO-001",
      "humanRef": "ameName",
      "attributes": {
        "ameId": "AME-PO-001",
        "ameName": "PO Approval",
        "transactionType": "PURCHASE_ORDER",
        "module": "PO",
        "approvalType": "POSITION",
        "conditions": "[{\"conditionName\":\"PO Amount GT 25000\",\"attributeName\":\"PO_TOTAL_AMOUNT\",\"operator\":\"GREATER_THAN\",\"conditionValue\":\"25000\"},{\"conditionName\":\"PO Amount GT 100000\",\"attributeName\":\"PO_TOTAL_AMOUNT\",\"operator\":\"GREATER_THAN\",\"conditionValue\":\"100000\"},{\"conditionName\":\"Capital Expenditure\",\"attributeName\":\"EXPENDITURE_TYPE\",\"operator\":\"EQUALS\",\"conditionValue\":\"CAPITAL\"}]",
        "rules": "[{\"ruleName\":\"Standard PO Approval\",\"ruleType\":\"AUTHORIZATION\",\"priority\":50,\"conditions\":[\"PO Amount GT 25000\"],\"actionType\":\"REQUIRE_APPROVAL\",\"approverType\":\"SUPERVISOR\"},{\"ruleName\":\"Capital PO Approval\",\"ruleType\":\"AUTHORIZATION\",\"priority\":20,\"conditions\":[\"PO Amount GT 100000\",\"Capital Expenditure\"],\"actionType\":\"REQUIRE_APPROVAL\",\"approverType\":\"POSITION\",\"approverValue\":\"VP_PROCUREMENT\"}]"
      },
      "relatesTo": [
        "ebs:PO",
        "ebs:P2P_Process"
      ]
    },
    {
      "id": "ebs:Workflow_APInvoiceApproval",
      "type": "Entity",
      "name": "AP Invoice Approval Workflow",
      "description": "Oracle Workflow for AP Invoice Approval — item type APINVOICE, routes invoices through AME-driven approval chain with notifications, reminders, escalations, and rejection handling.",
      "identityKey": "workflowId: WF-AP-001",
      "humanRef": "workflowName",
      "attributes": {
        "workflowId": "WF-AP-001",
