      ],
      "postcondition": [
        "Invoice created in ap_invoices_all with distributions",
        "Accounting entries created in XLA (xla_ae_lines)",
        "AME/Workflow triggered for approval routing",
        "Payment schedule created in ap_payment_schedules_all"
      ],
      "relatesTo": [
        "ebs:AP",
        "ebs:GL"
      ],
      "attributes": {
        "relationships": "operation_from -> Accounts Payable; operation_to -> General Ledger"
      }
    },
    {
      "id": "ebs:ProcessP2PCycle",
      "type": "Operation",
      "name": "Process Complete P2P Cycle",
