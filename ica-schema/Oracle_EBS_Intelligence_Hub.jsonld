      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_002",
        "rule_name": "DateTrack PER_PEOPLE_F Filter",
        "rule_type": "sql_compliance",
        "category": "EBS Compliance",
        "severity": "Critical",
        "applies_to_tables": "PER_PEOPLE_F; PER_ALL_PEOPLE_F",
        "sql_pattern": "FROM PER_PEOPLE_F without effective date filter",
