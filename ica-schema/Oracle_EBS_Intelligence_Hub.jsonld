        "relationships": "pattern_or_rule_applies_to_module -> Payroll; pattern_or_rule_used_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:PAY",
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:EBSReport_InvoiceRegister",
      "type": "RICEComponent",
      "name": "Invoice Register (APXINREG)",
      "description": "RDF-based AP Invoice Register report — lists all invoices for a period with vendor, amount, currency, approval status and payment status.",
      "identityKey": "reportId: RPT-AP-001",
      "humanRef": "reportName",
      "attributes": {
        "reportId": "RPT-AP-001",
        "reportName": "Invoice Register",
        "riceCategory": "R",
        "reportType": "RDF",
        "module": "AP",
        "businessProcess": "P2P",
        "concurrentProgramName": "APXINREG",
        "executableMethod": "ORACLE_REPORTS",
        "outputFormat": "PDF",
        "orgIdRequired": "true",
        "multiOrgEnabled": "true",
        "keyTables": "ap_invoices_all; po_vendors; po_vendor_sites_all",
        "parameters": "p_org_id; p_start_date; p_end_date",
        "primarySQLQuery": "SELECT aia.invoice_num, aia.invoice_date, aia.invoice_amount, aia.amount_paid, aia.invoice_currency_code, pv.vendor_name, pvs.vendor_site_code, aia.description, aia.payment_status_flag, aia.approval_status FROM ap_invoices_all aia, po_vendors pv, po_vendor_sites_all pvs WHERE aia.vendor_id = pv.vendor_id AND aia.vendor_site_id = pvs.vendor_site_id AND aia.org_id = :p_org_id AND aia.invoice_date BETWEEN :p_start_date AND :p_end_date ORDER BY pv.vendor_name, aia.invoice_num"
      },
      "relatesTo": [
        "ebs:AP",
        "ebs:P2P_Process"
      ]
    },
