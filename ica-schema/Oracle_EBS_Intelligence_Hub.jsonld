    {
      "id": "ebs:Report_po_distribution_detail",
      "name": "PO Distribution Detail",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: po_distribution_detail",
      "description": "PO Distribution Detail - PO report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "po_distribution_detail",
        "reportName": "PO Distribution Detail",
        "module": "PO",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_PO_DIST",
        "columns": "PO Number; Line#; Distribution#; GL Account; Cost Center; Fund; Amount; Quantity Ordered; Quantity Billed; Encumbrance Amount; Project; Task",
        "primarySQLQuery": "SELECT poh.segment1        po_number,\n       pol.line_num          line_num,\n       pod.distribution_num  dist_num,\n       gcc.concatenated_segments gl_account,\n       pod.code_combination_id,\n       pod.award_id          fund,\n       pod.amount_ordered    amount,\n       pod.quantity_ordered,\n       pod.quantity_billed,\n       pod.encumbered_amount,\n       pp.project_number,\n       pt.task_number\nFROM   po_distributions_all pod\nJOIN   po_headers_all       poh ON poh.po_header_id  = pod.po_header_id\nJOIN   po_lines_all         pol ON pol.po_line_id    = pod.po_line_id\nJOIN   gl_code_combinations gcc ON gcc.code_combination_id = pod.code_combination_id\nLEFT   JOIN pa_projects_all pp  ON pp.project_id    = pod.project_id\nLEFT   JOIN pa_tasks        pt  ON pt.task_id       = pod.task_id\nWHERE  poh.org_id = :p_org_id\nORDER BY poh.segment1, pol.line_num, pod.distribution_num",
        "appDataKey": "po_distribution",
        "relationships": "report_uses_table -> GL_CODE_COMBINATIONS; report_uses_table -> PA_PROJECTS_ALL; report_uses_table -> PA_TASKS; report_uses_table -> PO_DISTRIBUTIONS_ALL; report_uses_table -> PO_HEADERS_ALL; report_uses_table -> PO_LINES_ALL; report_belongs_to_module -> Purchasing"
      },
      "relatesTo": [
        "ebs:Table_GL_CODE_COMBINATIONS",
        "ebs:Table_PA_PROJECTS_ALL",
        "ebs:Table_PA_TASKS",
        "ebs:Table_PO_DISTRIBUTIONS_ALL",
        "ebs:Table_PO_HEADERS_ALL",
        "ebs:Table_PO_LINES_ALL",
        "ebs:PO"
      ]
    },
    {
      "id": "ebs:Report_receipt_adjustments",
      "name": "Receipt Adjustments",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: receipt_adjustments",
      "description": "Receipt Adjustments - PO report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "receipt_adjustments",
        "reportName": "Receipt Adjustments",
        "module": "PO",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_RCV",
        "columns": "Receipt Number; PO Number; Vendor Name; Item Description; Ordered Qty; Received Qty; Adjustment Qty; Adjustment Reason; Adjustment Date; Status",
        "primarySQLQuery": "SELECT rsh.receipt_num,\n       poh.segment1           po_number,\n       aps.vendor_name,\n       pol.item_description,\n       pol.quantity           ordered_qty,\n       rt.quantity            received_qty,\n       rca.adjustment_quantity,\n       rca.reason_code,\n       rca.creation_date      adjustment_date,\n       rca.status_code\nFROM   rcv_shipment_headers  rsh\nJOIN   rcv_transactions      rt  ON rt.shipment_header_id = rsh.shipment_header_id\nJOIN   rcv_corrections       rca ON rca.transaction_id    = rt.transaction_id\nJOIN   po_headers_all        poh ON poh.po_header_id      = rt.po_header_id\nJOIN   po_lines_all          pol ON pol.po_line_id        = rt.po_line_id\nJOIN   ap_suppliers          aps ON aps.vendor_id         = poh.vendor_id\nWHERE  rca.creation_date >= ADD_MONTHS(SYSDATE,-12)\nORDER BY rca.creation_date DESC",
        "appDataKey": "receipt_adjustments",
        "relationships": "report_uses_table -> AP_SUPPLIERS; report_uses_table -> PO_HEADERS_ALL; report_uses_table -> PO_LINES_ALL; report_uses_table -> RCV_CORRECTIONS; report_uses_table -> RCV_SHIPMENT_HEADERS; report_uses_table -> RCV_TRANSACTIONS; report_belongs_to_module -> Purchasing"
      },
      "relatesTo": [
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_PO_HEADERS_ALL",
        "ebs:Table_PO_LINES_ALL",
        "ebs:Table_RCV_CORRECTIONS",
        "ebs:Table_RCV_SHIPMENT_HEADERS",
        "ebs:Table_RCV_TRANSACTIONS",
        "ebs:PO"
      ]
    },
    {
      "id": "ebs:Report_savings_analysis",
      "name": "Savings Analysis",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: savings_analysis",
      "description": "Savings Analysis - PO report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "savings_analysis",
        "reportName": "Savings Analysis",
        "module": "PO",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_SAVINGS",
        "columns": "Buyer Name; Category; Vendor Name; Target Price; Actual Price; Qty Purchased; List Savings; Negotiated Savings; Total Savings; Savings %; FY Period",
        "primarySQLQuery": "SELECT ppf.full_name          buyer_name,\n       mcat.category_concat_segs category,\n       aps.vendor_name,\n       pol.list_price_per_unit   target_price,\n       pol.unit_price            actual_price,\n       pol.quantity,\n       (pol.list_price_per_unit - pol.unit_price)*pol.quantity savings,\n       pol.negotiated_by_preparer_flag,\n       pol.quantity*(pol.list_price_per_unit - pol.unit_price) total_savings,\n       ROUND((1 - pol.unit_price/NULLIF(pol.list_price_per_unit,0))*100,2) pct_savings,\n       TO_CHAR(poh.creation_date,'YYYY-MM') fy_period\nFROM   po_lines_all     pol\nJOIN   po_headers_all   poh  ON poh.po_header_id = pol.po_header_id\nJOIN   ap_suppliers     aps  ON aps.vendor_id    = poh.vendor_id\nJOIN   per_people_f     ppf  ON ppf.person_id    = poh.agent_id\nJOIN   mtl_categories   mcat ON mcat.category_id = pol.category_id\nWHERE  pol.list_price_per_unit IS NOT NULL\nORDER BY total_savings DESC",
        "appDataKey": "savings_analysis",
        "relationships": "report_uses_table -> AP_SUPPLIERS; report_uses_table -> MTL_CATEGORIES; report_uses_table -> PER_ALL_PEOPLE_F; report_uses_table -> PO_HEADERS_ALL; report_uses_table -> PO_LINES_ALL; report_belongs_to_module -> Purchasing"
      },
      "relatesTo": [
        "ebs:Table_AP_SUPPLIERS",
        "ebs:Table_MTL_CATEGORIES",
        "ebs:Table_PER_ALL_PEOPLE_F",
        "ebs:Table_PO_HEADERS_ALL",
        "ebs:Table_PO_LINES_ALL",
        "ebs:PO"
      ]
    },
    {
      "id": "ebs:Report_gl_journals",
      "name": "GL Journal Entries",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: gl_journals",
      "description": "GL Journal Entries - GL report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "gl_journals",
        "reportName": "GL Journal Entries",
        "module": "GL",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_GL_JNL",
        "columns": "Journal Name; Source; Category; Period Name; GL Account; Dr Amount; Cr Amount; Posted Status; Batch Name; Created By; Creation Date",
        "primarySQLQuery": "SELECT gjh.name            journal_name,\n       gjh.je_source         source,\n       gjh.je_category       category,\n       gjh.period_name,\n       gcc.concatenated_segments gl_account,\n       gjl.accounted_dr,\n       gjl.accounted_cr,\n       gjh.status            posted_status,\n       gjb.name              batch_name,\n       fu.user_name          created_by,\n       gjh.creation_date\nFROM   gl_je_headers  gjh\nJOIN   gl_je_lines    gjl ON gjl.je_header_id = gjh.je_header_id\nJOIN   gl_code_combinations gcc ON gcc.code_combination_id = gjl.code_combination_id\nJOIN   gl_je_batches  gjb ON gjb.je_batch_id  = gjh.je_batch_id\nJOIN   fnd_user       fu  ON fu.user_id       = gjh.created_by\nWHERE  gjh.period_name = :p_period\nORDER BY gjh.creation_date DESC",
        "appDataKey": "gl_journals",
        "relationships": "report_uses_table -> FND_USER; report_uses_table -> GL_CODE_COMBINATIONS; report_uses_table -> GL_JE_BATCHES; report_uses_table -> GL_JE_HEADERS; report_uses_table -> GL_JE_LINES; report_belongs_to_module -> General Ledger; report_uses_table -> GL_JE_HEADERS; report_uses_table -> GL_JE_LINES; report_uses_table -> GL_CODE_COMBINATIONS"
      },
      "relatesTo": [
        "ebs:Table_FND_USER",
        "ebs:Table_GL_CODE_COMBINATIONS",
        "ebs:Table_GL_JE_BATCHES",
        "ebs:Table_GL_JE_HEADERS",
        "ebs:Table_GL_JE_LINES",
        "ebs:GL"
      ]
    },
    {
      "id": "ebs:Report_gl_trial_balance",
      "name": "GL Trial Balance",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: gl_trial_balance",
      "description": "GL Trial Balance - GL report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "gl_trial_balance",
        "reportName": "GL Trial Balance",
        "module": "GL",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_GL_TB",
        "columns": "Account Code; Account Description; Account Type; Period Dr; Period Cr; Net Activity; Beg Balance; Ending Balance; Currency; Ledger",
        "primarySQLQuery": "SELECT gcc.concatenated_segments acct_code,\n       fav.description         acct_desc,\n       gcc.account_type,\n       SUM(gb.period_net_dr)   period_dr,\n       SUM(gb.period_net_cr)   period_cr,\n       SUM(gb.period_net_dr - gb.period_net_cr) net_activity,\n       SUM(gb.begin_balance_dr - gb.begin_balance_cr) beg_bal,\n       SUM((gb.begin_balance_dr + gb.period_net_dr) -\n           (gb.begin_balance_cr + gb.period_net_cr)) end_bal,\n       gb.currency_code,\n       gl.name                 ledger_name\nFROM   gl_balances            gb\nJOIN   gl_code_combinations   gcc ON gcc.code_combination_id = gb.code_combination_id\nJOIN   gl_ledgers             gl  ON gl.ledger_id            = gb.ledger_id\nLEFT   JOIN fnd_flex_values_vl fav ON fav.flex_value          = gcc.segment5\nWHERE  gb.period_name = :p_period\nAND    gb.actual_flag = 'A'\nGROUP BY gcc.concatenated_segments, fav.description, gcc.account_type,\n         gb.currency_code, gl.name\nORDER BY gcc.concatenated_segments",
        "appDataKey": "gl_trial_balance",
        "relationships": "report_uses_table -> FND_FLEX_VALUES_VL; report_uses_table -> GL_BALANCES; report_uses_table -> GL_CODE_COMBINATIONS; report_uses_table -> GL_LEDGERS; report_belongs_to_module -> General Ledger"
      },
      "relatesTo": [
        "ebs:Table_FND_FLEX_VALUES_VL",
        "ebs:Table_GL_BALANCES",
        "ebs:Table_GL_CODE_COMBINATIONS",
        "ebs:Table_GL_LEDGERS",
        "ebs:GL"
      ]
    },
    {
      "id": "ebs:Report_gl_account_analysis",
      "name": "Account Analysis",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: gl_account_analysis",
      "description": "Account Analysis - GL report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "gl_account_analysis",
        "reportName": "Account Analysis",
        "module": "GL",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_ACCT",
        "columns": "GL Account; Transaction Date; Journal Name; Source; Dr Amount; Cr Amount; Running Balance; Reference; Created By; Period",
        "primarySQLQuery": "SELECT gcc.concatenated_segments gl_account,\n       gjl.effective_date,\n       gjh.name            journal_name,\n       gjh.je_source       source,\n       gjl.accounted_dr,\n       gjl.accounted_cr,\n       SUM(gjl.accounted_dr - gjl.accounted_cr) OVER (\n           PARTITION BY gjl.code_combination_id\n           ORDER BY gjl.effective_date\n           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n       ) running_balance,\n       gjl.reference_1     reference,\n       fu.user_name        created_by,\n       gjh.period_name\nFROM   gl_je_lines    gjl\nJOIN   gl_je_headers  gjh ON gjh.je_header_id = gjl.je_header_id\nJOIN   gl_code_combinations gcc ON gcc.code_combination_id = gjl.code_combination_id\nJOIN   fnd_user       fu  ON fu.user_id = gjh.created_by\nWHERE  gjl.code_combination_id = :p_ccid\nAND    gjh.period_name BETWEEN :p_from AND :p_to\nORDER BY gjl.effective_date",
        "appDataKey": "gl_account_analysis",
        "relationships": "report_uses_table -> FND_USER; report_uses_table -> GL_CODE_COMBINATIONS; report_uses_table -> GL_JE_HEADERS; report_uses_table -> GL_JE_LINES; report_belongs_to_module -> General Ledger"
      },
      "relatesTo": [
        "ebs:Table_FND_USER",
        "ebs:Table_GL_CODE_COMBINATIONS",
        "ebs:Table_GL_JE_HEADERS",
        "ebs:Table_GL_JE_LINES",
        "ebs:GL"
      ]
    },
    {
      "id": "ebs:Report_iexpense_detail",
      "name": "iExpense Detail Report",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: iexpense_detail",
      "description": "iExpense Detail Report - iExpense report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "iexpense_detail",
        "reportName": "iExpense Detail Report",
        "module": "iExpense",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_IEXP",
        "columns": "Report Number; Employee Name; Report Date; OU; Expense Type; Amount; Reimbursable; Purpose; Approval Status; Submitted Date; Approver",
        "primarySQLQuery": "SELECT oiea.report_header_id  report_number,\n       ppf.full_name           employee_name,\n       oiea.week_end_date      report_date,\n       haou.name               ou_name,\n       oiel.web_parameter_id   expense_type,\n       oiel.amount,\n       oiel.reimbursable_amount,\n       oiea.description        purpose,\n       oiea.workflow_approved_flag approval_status,\n       oiea.submission_date,\n       ppf2.full_name          approver_name\nFROM   ap_expense_report_headers_all oiea\nJOIN   ap_expense_report_lines_all   oiel ON oiel.report_header_id = oiea.report_header_id\nJOIN   per_people_f                  ppf  ON ppf.person_id  = oiea.employee_id\nJOIN   hr_all_organization_units    haou  ON haou.organization_id = oiea.org_id\nLEFT   JOIN per_people_f            ppf2  ON ppf2.person_id = oiea.override_approver_id\nWHERE  oiea.source = 'Both'\nORDER BY oiea.submission_date DESC",
        "appDataKey": "iexpense_detail",
        "relationships": "report_uses_table -> AP_EXPENSE_REPORT_HEADERS_ALL; report_uses_table -> AP_EXPENSE_REPORT_LINES_ALL; report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_uses_table -> PER_ALL_PEOPLE_F; report_belongs_to_module -> iExpense; report_uses_table -> AP_EXPENSE_REPORT_HEADERS_ALL; report_uses_table -> AP_EXPENSE_REPORT_LINES_ALL; report_uses_table -> PER_ALL_PEOPLE_F"
      },
      "relatesTo": [
        "ebs:Table_AP_EXPENSE_REPORT_HEADERS_ALL",
        "ebs:Table_AP_EXPENSE_REPORT_LINES_ALL",
        "ebs:Table_HR_ALL_ORGANIZATION_UNITS",
        "ebs:Table_PER_ALL_PEOPLE_F",
        "ebs:iEXP"
      ]
    },
    {
      "id": "ebs:Report_credit_card_report",
      "name": "Credit Card Report",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: credit_card_report",
      "description": "Credit Card Report - iExpense report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "credit_card_report",
        "reportName": "Credit Card Report",
        "module": "iExpense",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_CC",
        "columns": "Transaction ID; Card Number (Masked); Employee Name; Transaction Date; Merchant; Category; Amount; Expense Report#; Status; Billed Date",
        "primarySQLQuery": "SELECT cct.transaction_id,\n       '****-****-****-'||SUBSTR(cct.card_number,-4) masked_card,\n       ppf.full_name          employee_name,\n       cct.transaction_date,\n       cct.merchant_name,\n       cct.category,\n       cct.transaction_amount,\n       aerh.report_header_id  expense_report_num,\n       cct.status,\n       cct.billed_date\nFROM   ap_credit_card_trxns_all cct\nJOIN   per_people_f              ppf  ON ppf.person_id    = cct.employee_id\nLEFT   JOIN ap_expense_report_headers_all aerh ON aerh.report_header_id = cct.report_header_id\nWHERE  cct.transaction_date BETWEEN :p_start AND :p_end\nORDER BY cct.transaction_date DESC",
        "appDataKey": "credit_card_report",
        "relationships": "report_uses_table -> AP_CREDIT_CARD_TRXNS_ALL; report_uses_table -> AP_EXPENSE_REPORT_HEADERS_ALL; report_uses_table -> PER_ALL_PEOPLE_F; report_belongs_to_module -> iExpense"
      },
      "relatesTo": [
        "ebs:Table_AP_CREDIT_CARD_TRXNS_ALL",
        "ebs:Table_AP_EXPENSE_REPORT_HEADERS_ALL",
        "ebs:Table_PER_ALL_PEOPLE_F",
        "ebs:iEXP"
      ]
    },
    {
      "id": "ebs:Report_workflow_approvals",
      "name": "Workflow Approvals",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: workflow_approvals",
      "description": "Workflow Approvals - iExpense report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "workflow_approvals",
        "reportName": "Workflow Approvals",
        "module": "iExpense",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "true",
        "csvNodeId": "RPT_WF",
        "columns": "Report Number; Employee; Report Amount; Submitted Date; Approver Level 1; L1 Action Date; Approver Level 2; L2 Action Date; Final Status; Cycle Time (Days); Notes",
        "primarySQLQuery": "SELECT aerh.report_header_id  report_num,\n       ppf.full_name           employee_name,\n       aerh.total             report_amount,\n       aerh.submission_date,\n       ppf2.full_name         approver_l1,\n       wn1.action_date        l1_action_date,\n       ppf3.full_name         approver_l2,\n       wn2.action_date        l2_action_date,\n       aerh.workflow_approved_flag final_status,\n       ROUND(NVL(wn2.action_date,SYSDATE) - aerh.submission_date,0) cycle_days,\n       wn1.notification_comment notes\nFROM   ap_expense_report_headers_all aerh\nJOIN   per_people_f                  ppf  ON ppf.person_id  = aerh.employee_id\nLEFT   JOIN wf_notifications wn1 ON wn1.item_key = TO_CHAR(aerh.report_header_id) AND wn1.activity_name LIKE '%APPROVE%L1%'\nLEFT   JOIN wf_notifications wn2 ON wn2.item_key = TO_CHAR(aerh.report_header_id) AND wn2.activity_name LIKE '%APPROVE%L2%'\nLEFT   JOIN per_people_f ppf2 ON ppf2.person_id = TO_NUMBER(wn1.to_user)\nLEFT   JOIN per_people_f ppf3 ON ppf3.person_id = TO_NUMBER(wn2.to_user)\nWHERE  aerh.source = 'Both'\nORDER BY aerh.submission_date DESC",
        "appDataKey": "workflow_approvals",
        "relationships": "report_uses_table -> AP_EXPENSE_REPORT_HEADERS_ALL; report_uses_table -> PER_ALL_PEOPLE_F; report_uses_table -> WF_NOTIFICATIONS; report_belongs_to_module -> iExpense"
      },
      "relatesTo": [
        "ebs:Table_AP_EXPENSE_REPORT_HEADERS_ALL",
        "ebs:Table_PER_ALL_PEOPLE_F",
        "ebs:Table_WF_NOTIFICATIONS",
        "ebs:iEXP"
      ]
    },
    {
      "id": "ebs:Report_active_employees",
      "name": "Active Employees",
      "type": "Entity",
      "humanRef": "reportName",
      "identityKey": "reportKey: active_employees",
      "description": "Active Employees - HRMS report in the EBS Reports tab.",
      "attributes": {
        "entityType": "EBSReport",
        "reportKey": "active_employees",
        "reportName": "Active Employees",
        "module": "HRMS",
        "sampleRows": "100",
        "hasSampleData": "true",
        "outputFormats": "CSV; Excel; PDF",
        "orgIdRequired": "false",
        "csvNodeId": "RPT_ACTIEMP",
        "columns": "Employee ID; Full Name; Job; Department; Grade; Hire Date; Years of Service; Supervisor; Cost Center; Position; FTE; Payroll",
        "primarySQLQuery": "SELECT ppf.employee_number,\n       ppf.full_name,\n       pj.name job_title,\n       haou.name department,\n       pg.name grade,\n       ppf.original_date_of_hire,\n       ROUND((SYSDATE-ppf.original_date_of_hire)/365,1) yrs_service,\n       ppf2.full_name supervisor,\n       paf.default_code_comb_id cost_center,\n       pp.name position_name,\n       paf.fte,\n       ppg.payroll_name\nFROM   per_people_f     ppf\nJOIN   per_assignments_f paf ON paf.person_id = ppf.person_id AND paf.primary_flag='Y'\n  AND SYSDATE BETWEEN paf.effective_start_date AND paf.effective_end_date\nJOIN   per_jobs         pj   ON pj.job_id = paf.job_id\nJOIN   hr_all_organization_units haou ON haou.organization_id = paf.organization_id\nJOIN   per_grades       pg   ON pg.grade_id = paf.grade_id\nJOIN   per_positions    pp   ON pp.position_id = paf.position_id\nJOIN   pay_payrolls_f   ppg  ON ppg.payroll_id = paf.payroll_id\nLEFT   JOIN per_people_f ppf2 ON ppf2.person_id = paf.supervisor_id\nWHERE  ppf.current_employee_flag = 'Y'\nORDER BY ppf.full_name",
        "appDataKey": "active_employees",
        "relationships": "report_uses_table -> HR_ALL_ORGANIZATION_UNITS; report_uses_table -> PAY_PAYROLLS_F; report_uses_table -> PER_ALL_ASSIGNMENTS_F; report_uses_table -> PER_GRADES; report_uses_table -> PER_JOBS; report_uses_table -> PER_ALL_PEOPLE_F; report_uses_table -> PER_POSITIONS; report_belongs_to_module -> Human Resources; report_uses_table -> PER_ALL_PEOPLE_F; report_uses_table -> PER_ALL_ASSIGNMENTS_F; report_uses_table -> HR_ALL_ORGANIZATION_UNITS"
      },
      "relatesTo": [
        "ebs:Table_HR_ALL_ORGANIZATION_UNITS",
        "ebs:Table_PAY_PAYROLLS_F",
        "ebs:Table_PER_ALL_ASSIGNMENTS_F",
