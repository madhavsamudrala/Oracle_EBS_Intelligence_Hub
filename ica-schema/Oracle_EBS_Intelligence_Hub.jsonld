        "rule_type": "sql_compliance",
        "category": "EBS Compliance",
        "severity": "Major",
        "applies_to_tables": "XXCUST_* custom tables",
        "sql_pattern": "CREATE TABLE xxcust_* without WHO columns",
        "correction": "CREATED_BY NUMBER NOT NULL, CREATION_DATE DATE NOT NULL, LAST_UPDATED_BY NUMBER NOT NULL, LAST_UPDATE_DATE DATE NOT NULL, LAST_UPDATE_LOGIN NUMBER",
        "code_review_check_number": "18",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_027",
      "name": "FND_GLOBAL Context Required for EBS APIs",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_027",
      "description": "All Oracle EBS public APIs (hr_employee_api, AP_VENDOR_PUB, etc.) require FND_GLOBAL context to be set before calling. Missing context causes API failures or incorrect auditing",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_027",
        "rule_name": "FND_GLOBAL Context Required for EBS APIs",
        "rule_type": "sql_compliance",
        "category": "EBS Compliance",
        "severity": "Critical",
        "applies_to_tables": "all API calls",
        "sql_pattern": "Call to HR_EMPLOYEE_API or AP_VENDOR_PUB without FND_GLOBAL.APPS_INITIALIZE",
        "correction": "FND_GLOBAL.APPS_INITIALIZE(user_id => :p_user_id, resp_id => :p_resp_id, resp_appl_id => :p_resp_appl_id);",
        "code_review_check_number": "19",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_028",
      "name": "Use EXISTS Instead of IN for Subqueries",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_028",
      "description": "WHERE col IN (SELECT ...) evaluates the entire subquery before the outer query. WHERE EXISTS (SELECT 1 FROM ...) stops at first match — significantly faster on large EBS tables",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_028",
        "rule_name": "Use EXISTS Instead of IN for Subqueries",
        "rule_type": "sql_compliance",
        "category": "Performance",
        "severity": "Major",
        "applies_to_tables": "all",
        "sql_pattern": "WHERE col IN (SELECT large_table ...)",
        "correction": "WHERE EXISTS (SELECT 1 FROM large_table WHERE ...)",
        "code_review_check_number": "26",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
