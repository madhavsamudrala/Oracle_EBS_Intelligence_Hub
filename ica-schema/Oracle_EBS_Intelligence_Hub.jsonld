    {
      "id": "ebs:AppRule_RULE_008",
      "name": "SELECT * Wildcard Prohibited",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_008",
      "description": "SELECT * retrieves all columns including BLOBs — breaks if table structure changes and prevents index-only scans",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_008",
        "rule_name": "SELECT * Wildcard Prohibited",
        "rule_type": "sql_compliance",
        "category": "Performance",
        "severity": "Critical",
        "applies_to_tables": "all",
        "sql_pattern": "SELECT *",
        "correction": "List only required columns explicitly",
        "code_review_check_number": "2",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_009",
      "name": "Correlated Scalar Subquery N+1",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_009",
      "description": "SELECT (SELECT ...) in column list executes once per row — N+1 performance issue on large tables",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_009",
        "rule_name": "Correlated Scalar Subquery N+1",
        "rule_type": "sql_compliance",
        "category": "Performance",
        "severity": "Critical",
        "applies_to_tables": "all",
        "sql_pattern": "SELECT (SELECT ...) FROM ...",
        "correction": "Use a JOIN or WITH clause CTE instead",
        "code_review_check_number": "3",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_010",
      "name": "EXECUTE IMMEDIATE SQL Injection",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_010",
      "description": "EXECUTE IMMEDIATE with string concatenation creates SQL injection vulnerability — must use bind variables",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_010",
        "rule_name": "EXECUTE IMMEDIATE SQL Injection",
        "rule_type": "sql_compliance",
        "category": "Security",
        "severity": "Critical",
        "applies_to_tables": "all",
        "sql_pattern": "EXECUTE IMMEDIATE 'SELECT' || variable",
        "correction": "EXECUTE IMMEDIATE sql_text USING bind_var1, bind_var2",
        "code_review_check_number": "27",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_011",
      "name": "LIKE Leading Wildcard Index Bypass",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_011",
      "description": "LIKE '%value' cannot use a B-Tree index — causes full table scan on potentially millions of rows",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_011",
        "rule_name": "LIKE Leading Wildcard Index Bypass",
        "rule_type": "sql_compliance",
        "category": "Performance",
        "severity": "Major",
        "applies_to_tables": "all",
        "sql_pattern": "LIKE '%...'",
        "correction": "Use LIKE 'value%' or Oracle Text full-text search",
        "code_review_check_number": "15",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_012",
      "name": "NOT IN with NULLs",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_012",
      "description": "NOT IN (SELECT ...) returns zero rows if the subquery contains any NULL — use NOT EXISTS instead",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_012",
        "rule_name": "NOT IN with NULLs",
        "rule_type": "sql_compliance",
        "category": "SQL Best Practice",
        "severity": "Critical",
        "applies_to_tables": "all",
        "sql_pattern": "WHERE col NOT IN (SELECT ...)",
        "correction": "WHERE NOT EXISTS (SELECT 1 FROM ... WHERE ...)",
        "code_review_check_number": "16",
        "relationships": "rule_checked_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:AppRule_RULE_013",
      "name": "ROWNUM with ORDER BY",
      "type": "Entity",
      "humanRef": "ruleName",
      "identityKey": "ruleId: RULE_013",
      "description": "ROWNUM is applied before ORDER BY — results in wrong top-N rows. Use FETCH FIRST or subquery pattern",
      "attributes": {
        "entityType": "BusinessRule",
        "rule_id": "RULE_013",
        "rule_name": "ROWNUM with ORDER BY",
        "rule_type": "sql_compliance",
        "category": "SQL Best Practice",
        "severity": "Critical",
        "applies_to_tables": "all",
        "sql_pattern": "WHERE ROWNUM <= N ORDER BY col",
        "correction": "SELECT * FROM (...ORDER BY col) WHERE ROWNUM <= N",
