      "id": "ebs:AP",
      "type": "Entity",
      "name": "Accounts Payable",
      "description": "Oracle EBS AP module — supplier invoice processing, 3-way matching, payment runs, aging, withholding tax, and GL transfer. Primary process: P2P.",
      "identityKey": "moduleCode: AP",
      "humanRef": "moduleName",
      "attributes": {
        "moduleCode": "AP",
        "moduleName": "Accounts Payable",
        "moduleCategory": "FINANCIAL",
        "businessProcess": "P2P",
        "releaseVersion": "R12.2",
        "licenseType": "CORE",
        "keySchema": "APPS",
        "commonInvoiceTypes": "STANDARD; CREDIT; DEBIT; PREPAYMENT; EXPENSE REPORT; INTEREST; MIXED",
        "matchingTypes": "PO_MATCH_2WAY; PO_MATCH_3WAY; PO_MATCH_4WAY; NO_MATCH",
        "keySetupSteps": "Financial Options; Payables Options; Payment Terms; Supplier Master; Banks & Bank Accounts; Payment Documents",
        "relationships": "module_has_report -> Suppliers Report; module_has_report -> Suppliers High Payments; module_has_report -> Supplier Paid Invoice History; module_has_report -> Supplier Payment History; module_has_report -> Supplier Audit Report; module_has_report -> Aged Payables Detail; module_has_report -> AP Trial Balance; module_has_report -> Invoice Register; module_has_report -> Withholding Tax by Supplier; module_has_compliance_rule -> ORG_ID Required on All Multi-Org Tables; module_has_compliance_rule -> DateTrack Effective Date Filter Required; module_has_rice_component -> AP Open Invoices Conversion; module_has_rice_component -> Invoice Register (APXINREG); module_delivered_by_reusable_accelerator -> IBM Consulting Reusable Accelerator; module_governed_by_dasc_model -> IBM DASC Compliance Model; module_served_via_ica_context_studio -> IBM ICA Context Studio via MCP Gateway"
      },
      "invariant": [
        "All invoices require ORG_ID filter on _ALL tables",
        "Cancelled invoices must be excluded: AND cancelled_date IS NULL",
        "Invoice amounts must balance to distributions",
        "Payment requires approved and validated invoice",
        "3-way match requires approved PO shipment",
        "GL date must be in open AP period",
        "Void payments excluded: AND void_date IS NULL",
        "iExpense rows filtered: AND source = 'NonValidatedWebExpense'"
