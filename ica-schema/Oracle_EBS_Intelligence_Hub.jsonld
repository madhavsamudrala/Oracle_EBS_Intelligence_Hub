      ]
    },
    {
      "id": "ebs:Rule_Bind_Variables",
      "type": "Entity",
      "name": "Bind Variables Required — No Hard-Coded Literals",
      "description": "Always use bind variables (:p_name) in SQL queries. Hard-coded literals cause SQL injection risk, hard-parsing, and shared pool exhaustion.",
      "identityKey": "ruleId: COMP-007",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-007",
        "ruleName": "Bind Variables Required",
        "category": "SECURITY",
        "severity": "CRITICAL",
        "codeReviewScore": "-20",
        "affectedModules": "AP; AR; GL; PO; INV; HRMS; PAY; FA; CM; BEN; iEXP; OM",
        "violationImpact": "SQL injection vulnerability, hard-parsing on every execution, shared pool exhaustion, security audit failure",
        "correctUsage": "WHERE org_id = :p_org_id AND vendor_id = :p_vendor_id",
        "incorrectUsage": "WHERE org_id = 101 AND vendor_id = 5432  -- NEVER hardcode IDs",
        "relationships": "pattern_or_rule_used_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:Rule_No_Select_Star",
      "type": "Entity",
      "name": "No SELECT * in Production SQL",
      "description": "Never use SELECT * in production Oracle EBS queries. Always name columns explicitly.",
      "identityKey": "ruleId: COMP-008",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-008",
        "ruleName": "No SELECT Star",
        "category": "PERFORMANCE",
        "severity": "MAJOR",
        "codeReviewScore": "-10",
        "affectedModules": "AP; AR; GL; PO; INV; HRMS; PAY",
        "violationImpact": "Full row fetch overhead, excess network bandwidth, index-only scan impossible, implicit conversion risks, columns shift on DDL changes",
        "correctUsage": "SELECT invoice_num, invoice_amount, vendor_name FROM ap_invoices_all aia",
        "incorrectUsage": "SELECT * FROM ap_invoices_all  -- NEVER use SELECT *",
        "relationships": "pattern_or_rule_used_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
    {
      "id": "ebs:Rule_No_Function_On_Index",
      "type": "Entity",
      "name": "No Functions on Indexed Columns",
      "description": "Avoid wrapping indexed columns in functions (TRUNC, TO_CHAR, NVL) as this prevents index usage and forces full table scans.",
      "identityKey": "ruleId: COMP-009",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-009",
        "ruleName": "No Function on Indexed Column",
        "category": "PERFORMANCE",
        "severity": "MAJOR",
        "codeReviewScore": "-10",
        "affectedModules": "AP; AR; GL; PO; INV; HRMS; PAY",
        "violationImpact": "Index scan disabled, full table scan required, query performance 10x-100x degraded on large _ALL tables",
        "correctUsage": "WHERE invoice_date BETWEEN :p_start_date AND :p_end_date",
        "incorrectUsage": "WHERE TO_CHAR(invoice_date, 'YYYY') = '2025'  -- prevents index use",
        "relationships": "pattern_or_rule_used_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:tab_sql"
      ]
    },
