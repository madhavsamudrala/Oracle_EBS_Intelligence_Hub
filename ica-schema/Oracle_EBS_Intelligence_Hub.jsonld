        "PO created and approved",
        "Goods received (rcv_transactions)",
        "Invoice matched, validated, and approved",
        "Payment processed (ap_checks_all)",
        "GL entries posted (gl_je_lines)",
        "Bank reconciliation complete"
      ],
      "relatesTo": [
        "ebs:PO",
        "ebs:CM"
      ],
      "attributes": {
        "relationships": "operation_from -> Purchasing; operation_to -> Cash Management"
      }
    },
    {
      "id": "ebs:ProcessPeriodClose",
      "type": "Operation",
      "name": "Process Month-End Period Close (R2R)",
      "description": "Execute complete month-end period close sequence across all subledgers and GL.",
      "from": "ebs:GL",
      "to": "ebs:GL",
      "precondition": [
        "All subledger (AP/AR/FA/PAY) transfers to GL complete",
        "All journals posted — no journals in 'unposted' status",
        "Suspense account balance = zero",
        "Management approval obtained for closure",
        "All bank reconciliations complete"
      ],
      "postcondition": [
        "GL period status = 'Closed'",
        "Trial balance in balance (Dr = Cr)",
        "Financial statements generated via FSG",
        "Next period opened for transactions",
        "Archive and backup complete"
      ],
      "relatesTo": [
        "ebs:GL"
      ],
      "attributes": {
        "relationships": "operation_from -> General Ledger; operation_to -> General Ledger"
      }
    },
    {
      "id": "ebs:Rule_OrgId_Required",
      "type": "Entity",
      "name": "ORG_ID Required on All Multi-Org Tables",
      "description": "All _ALL multi-org tables must include an AND org_id = :p_org_id filter in every SQL query to prevent cross-org data exposure and ensure correct results.",
      "identityKey": "ruleId: COMP-001",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-001",
        "ruleName": "ORG_ID Required",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": "-20",
        "affectedModules": "AP; AR; PO; INV; OM; iEXP; CM; FA",
        "affectedTables": "ap_invoices_all; ap_invoice_distributions_all; ap_checks_all; ap_holds_all; ap_payment_schedules_all; ra_customer_trx_all; ra_customer_trx_lines_all; ar_cash_receipts_all; po_headers_all; po_lines_all; po_line_locations_all; po_distributions_all; po_requisition_headers_all; mtl_material_transactions; mtl_onhand_quantities_detail; oe_order_headers_all; oe_order_lines_all; ap_expense_report_headers_all",
        "violationImpact": "Full cross-org table scan, wrong org data returned, performance degradation, data security breach, multi-org compliance failure",
        "correctUsage": "WHERE table.org_id = :p_org_id",
        "incorrectUsage": "Missing org_id filter entirely from WHERE clause"
      },
      "invariant": [
        "org_id must be present in WHERE clause",
        "org_id must use bind variable :p_org_id not hardcoded value",
        "org_id must reference the correct operating unit"
      ]
    },
    {
      "id": "ebs:Rule_DateTrack_Required",
      "type": "Entity",
      "name": "DateTrack Effective Date Filter Required",
      "description": "All HRMS/PAY/BEN DateTracked tables (with _F suffix) require BETWEEN effective_start_date AND effective_end_date filter.",
      "identityKey": "ruleId: COMP-002",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-002",
        "ruleName": "DateTrack Filter Required",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": "-20",
        "affectedModules": "HRMS; PAY; BEN",
        "affectedTables": "per_all_people_f; per_all_assignments_f; hr_all_positions_f; pay_payrolls_f; pay_element_types_f; pay_input_values_f; pay_element_entries_f; pay_element_entry_values_f; ben_prtt_enrt_rslt_f; ben_pgm_f; ben_pl_f; ben_pl_typ_f; ben_opt_f; ben_ler_f",
        "violationImpact": "Multiple rows returned per employee/element (one per change history), incorrect aggregations, wrong headcount, payroll calculation errors",
        "correctUsage": "WHERE SYSDATE BETWEEN table.effective_start_date AND table.effective_end_date",
        "historicalUsage": "WHERE :p_as_of_date BETWEEN table.effective_start_date AND table.effective_end_date",
        "incorrectUsage": "Missing date filter on any DateTracked _F table"
      }
    },
    {
      "id": "ebs:Rule_GL_LedgerId",
      "type": "Entity",
      "name": "GL Tables Use ledger_id Not org_id",
      "description": "GL module tables use ledger_id for scoping, NOT org_id. Using org_id on GL tables returns incorrect results or errors.",
      "identityKey": "ruleId: COMP-003",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-003",
        "ruleName": "GL Ledger ID Filter",
        "category": "COMPLIANCE",
        "severity": "CRITICAL",
        "codeReviewScore": "-20",
        "affectedModules": "GL",
        "affectedTables": "gl_je_headers; gl_je_lines; gl_balances; gl_ledgers; gl_period_statuses; gl_budget_versions; xla_ae_headers; xla_ae_lines",
        "violationImpact": "Wrong ledger data returned, cross-ledger data mixing, incorrect financial statements, reporting failures",
        "correctUsage": "WHERE gjh.ledger_id = :p_ledger_id",
        "incorrectUsage": "WHERE gjh.org_id = :p_org_id  -- WRONG: GL uses ledger_id"
      }
    },
    {
      "id": "ebs:Rule_Cancelled_Invoice_Filter",
      "type": "Entity",
      "name": "Exclude Cancelled AP Invoices",
      "description": "Always exclude cancelled invoices from AP reporting by adding AND cancelled_date IS NULL.",
      "identityKey": "ruleId: COMP-004",
      "humanRef": "ruleName",
      "attributes": {
        "ruleId": "COMP-004",
        "ruleName": "Cancelled Invoice Filter",
        "category": "COMPLIANCE",
        "severity": "MAJOR",
        "codeReviewScore": "-10",
        "affectedModules": "AP",
        "affectedTables": "ap_invoices_all",
        "violationImpact": "Cancelled invoices appear in aging, payment runs, and outstanding balance reports — incorrect financial totals",
        "correctUsage": "AND aia.cancelled_date IS NULL",
        "incorrectUsage": "Missing cancelled_date IS NULL filter",
        "relationships": "pattern_or_rule_applies_to_module -> Accounts Payable; pattern_or_rule_used_in_tab -> SQL Advisor"
      },
      "relatesTo": [
        "ebs:AP",
        "ebs:tab_sql"
      ]
    },
    {
